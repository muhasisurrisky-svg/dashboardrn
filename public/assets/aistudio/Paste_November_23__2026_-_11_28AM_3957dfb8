/** Perbandingan waktu-konstan. */
function sama_(a, b) {
  a = String(a); b = String(b);
  const n = Math.max(a.length, b.length);
  let d = a.length ^ b.length;
  for (let i = 0; i < n; i++) d |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return d === 0;
}

function sandiPeran_(role) {
  const kunci = (role === 'admin') ? 'SANDI_ADMIN' : 'SANDI_USER';
  return String(PropertiesService.getScriptProperties().getProperty(kunci) || '');
}

/** Dipanggil dari Index.html. role: 'admin' atau 'user'. */
function login(role, sandi) {
  role = (role === 'admin') ? 'admin' : 'user';
  const cache = CacheService.getScriptCache();
  const kg = 'gagal_' + userKey_();
  const gagal = Number(cache.get(kg) || 0);
  const gagalG = Number(cache.get('gagal_global') || 0);
  if (gagal >= MAKS_GAGAL || gagalG >= MAKS_GAGAL_GLOBAL) {
    return { ok: false, pesan: 'Terlalu banyak percobaan. Coba lagi dalam ' + KUNCI_MENIT + ' menit.' };
  }
  const benar = sandiPeran_(role);
  if (!benar) {
    return { ok: false, pesan: 'Sandi ' + role + ' belum diatur di Script properties.' };
  }
  if (sama_(sandi, benar)) {
    cache.remove(kg);
    const token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
    cache.put('sesi_' + token, role, Math.min(SESI_JAM, 6) * 3600);
    return { ok: true, token: token, role: role };
  }
  cache.put(kg, String(gagal + 1), KUNCI_MENIT * 60);
  cache.put('gagal_global', String(gagalG + 1), KUNCI_MENIT * 60);
  const sisa = MAKS_GAGAL - (gagal + 1);
  return { ok: false, pesan: sisa > 0 ? 'Sandi salah. Sisa percobaan: ' + sisa + '.' : 'Terlalu banyak percobaan. Coba lagi dalam ' + KUNCI_MENIT + ' menit.' };
}

function logout(token) {
  if (token) CacheService.getScriptCache().remove('sesi_' + token);
  return true;
}

/** Mengembalikan 'admin' / 'user', atau null bila sesi tidak valid. */
function peran_(token) {
  if (!token) return null;
  const cache = CacheService.getScriptCache();
  const k = 'sesi_' + token;
  const r = cache.get(k);
  if (r !== 'admin' && r !== 'user') return null;
  cache.put(k, r, Math.min(SESI_JAM, 6) * 3600);
  return r;
}

function sesiValid_(token) { return peran_(token) !== null; }

/** Sembunyikan tautan spreadsheet dari akun User. */
function untukPeran_(data, role) {
  const out = JSON.parse(JSON.stringify(data));
