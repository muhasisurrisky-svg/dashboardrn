function getTglAnggaran_(ss) {
  const v = sheet_(ss, SH.ANG_DASH).getRange(1, 1, 8, 6).getDisplayValues();
  for (let i = 0; i < v.length; i++) {
    for (let j = 0; j < v[i].length; j++) {
      const s = String(v[i][j]);
      if (/zfmf01/i.test(s)) {
        const m = s.match(/tanggal\s*:?\s*(.+)$/i);
        return m ? m[1].trim() : s.trim();
      }
    }
  }
  return null;
}

function getAnggaran_(ss) {
  const t = readTable_(ss, SH.ANGGARAN, 1);
  const h = t.head, S = SH.ANGGARAN;
  const iNo = col_(h, 'no'), iFC = col_(h, 'funds center');
  const iCI = need_(col_(h, 'cost item'), 'Cost Item (CI)', S);
  const iRkap = need_(col_(h, 'rkap'), 'RKAP', S);
  const iRel = need_(col_(h, 'release budget'), 'Release Budget', S);
  const iCom = col_(h, 'commitment'), iAct = col_(h, 'actual');
  const iCon = need_(col_(h, 'consumed budget'), 'Consumed Budget', S);
  const iAv = col_(h, 'budget available');

  const rows = [];
  t.rows.forEach(function (r) {
    const ci = String(r[iCI] || '').trim();
    if (!ci || /^(total|jumlah|perencanaan)/i.test(ci)) return;
    if (iNo > -1 && !String(r[iNo] || '').trim()) return;
    const rel = num_(r[iRel]), con = num_(r[iCon]);
    rows.push({
      no: iNo > -1 ? r[iNo] : '',
      fc: iFC > -1 ? r[iFC] : '',
      ci: ci,
      rkap: num_(r[iRkap]),
      release: rel,
      commitment: iCom > -1 ? num_(r[iCom]) : 0,
      actual: iAct > -1 ? num_(r[iAct]) : 0,
      consumed: con,
      available: iAv > -1 ? num_(r[iAv]) : rel - con,
      pct: rel > 0 ? con / rel * 100 : 0
    });
  });

  const total = { rkap: 0, release: 0, commitment: 0, actual: 0, consumed: 0, available: 0 };
  rows.forEach(function (r) { Object.keys(total).forEach(function (k) { total[k] += r[k]; }); });
  total.pct = total.release > 0 ? total.consumed / total.release * 100 : 0;
  return { rows: rows, total: total };
}

/**
 * Kurva anggaran bulanan (opsional, tidak memunculkan error bila sheet belum ada).
 * Sheet "KURVA ANGGARAN": kolom Periode | Rencana Kumulatif | Konsumsi Kumulatif, nilai Rupiah kumulatif.
 * Hasil: [{periode, rencana, konsumsi}], konsumsi null untuk bulan yang belum terisi.
 */
function getKurvaAnggaran_(ss, namaSheet) {
  try {
    const sh = ss.getSheetByName(namaSheet);
    if (!sh) return null;
    const v = sh.getDataRange().getDisplayValues();
    let hr = -1;
    for (let i = 0; i < Math.min(v.length, 10) && hr < 0; i++) {
      if (v[i].some(function (c) { return norm_(c) === 'periode'; })) hr = i;
    }
    if (hr < 0) return null;
    const h = v[hr].map(norm_);
    const iP = h.indexOf('periode');
    const iR = h.findIndex(function (x) { return x.indexOf('rencana') === 0; });
    const iK = h.findIndex(function (x) { return x.indexOf('konsumsi') === 0 || x.indexOf('consumed') === 0 || x.indexOf('realisasi') === 0; });
    if (iR < 0 || iK < 0) return null;
    const out = [];
    for (let i = hr + 1; i < v.length; i++) {
      const p = String(v[i][iP] || '').trim();
      if (!p || /^(total|jumlah)/i.test(p)) continue;
      const r = String(v[i][iR]).trim(), k = String(v[i][iK]).trim();
      out.push({ periode: p, rencana: r === '' ? null : num_(r), konsumsi: k === '' ? null : num_(k) });
    }
    return out.length ? out : null;
  } catch (e) { return null; }
}

function getPengadaan_(ss) {
  const t = readTable_(ss, SH.PENGADAAN, 1);
  const h = t.head, S = SH.PENGADAAN;
  const iNo = col_(h, 'no dok');
  const iDesk = need_(col_(h, 'deskripsi pekerjaan'), 'Deskripsi Pekerjaan', S);
  const iCI = col_(h, 'deskripsi ci');
  const iTipe = col_(h, 'tipe pengadaan');
  const iVen = col_(h, 'vendor');
  const iSpk = col_(h, 'nilai spk');
  const iTgl = col_(h, 'tgl spk');
  const iPos = col_(h, 'posisi berkas');
  const iSt = col_(h, 'status');
  const iKat = col_(h, 'kategori');
  const iBln = col_(h, 'bulan kontrak');
  const tahunSS = (ss.getId() === SS_ID_2027) ? 2027 : 2026;

  const get = function (r, i) { return i > -1 ? String(r[i] || '').trim() : ''; };
  const rows = [];
  const hit = { 'Selesai': 0, 'Dalam Proses': 0, 'Gagal/Batal': 0 };
  const perBulanJml = new Array(12).fill(0);
  const perBulanNilai = new Array(12).fill(0);
  let totalSpk = 0;

  t.rows.forEach(function (r) {
    if (!get(r, iDesk)) return;
    if (barisTotal_(get(r, iDesk))) return;
    const kat = katPbj_(get(r, iKat) || get(r, iSt));
    hit[kat]++;

    let spk = iSpk > -1 ? num_(r[iSpk]) : 0;
    if (!NILAI_BATAL_DIHITUNG && kat === 'Gagal/Batal') spk = 0;
    totalSpk += spk;

    // Bulan: pakai kolom "Bulan Kontrak"; kalau kosong, ambil dari tanggal SPK
    let bln = iBln > -1 ? Math.round(num_(r[iBln])) : 0;
    if (!(bln >= 1 && bln <= 12)) {
      const tg = parseTgl_(get(r, iTgl));
      bln = (tg && tg.y === tahunSS) ? tg.m : 0;
    }
    if (bln >= 1 && bln <= 12) {
      perBulanJml[bln - 1]++;
      perBulanNilai[bln - 1] += spk;
    }
    rows.push([
      get(r, iNo), get(r, iDesk), get(r, iCI), get(r, iTipe), rapiVendor_(get(r, iVen)),
      spk, get(r, iTgl), get(r, iPos), get(r, iSt), kat, bln
    ]);
  });

  const total = rows.length;
  return {
    total: total,
    selesai: hit['Selesai'],
    proses: hit['Dalam Proses'],
    gagal: hit['Gagal/Batal'],
    pctSelesai: total > 0 ? hit['Selesai'] / total * 100 : 0,
    totalSpk: totalSpk,
    perBulanJml: perBulanJml,
    perBulanNilai: perBulanNilai,
    rows: rows
  };
}

/** Dipakai 2026 dan 2025: namaSum = sheet ringkasan (Program | Total Unit), namaDetail = sheet detail unit. */
function getProgram_(ss, namaSum, namaDetail) {
  const v = sheet_(ss, namaSum).getDataRange().getDisplayValues();
  let hr = -1, hc = -1;
  for (let i = 0; i < v.length && hr < 0; i++) {
    for (let j = 0; j < v[i].length - 1; j++) {
      if (norm_(v[i][j]) === 'program' && norm_(v[i][j + 1]) === 'total unit') { hr = i; hc = j; break; }
    }
  }
  if (hr < 0) throw new Error('Tabel "Program | Total Unit" tidak ditemukan di sheet ' + namaSum);
  const head = v[hr].slice(hc).map(norm_);
  const ix = function (n) { return col_(head, n); };
  const iT = ix('total unit'), iR = ix('realisasi'), iTs = ix('tsgo'), iB = ix('belum masuk'),
        iK = ix('konservasi'), iL = ix('lainnya');
  const ringkas = [];
  for (let i = hr + 1; i < v.length; i++) {
    const p = String(v[i][hc] || '').trim();
    if (!p || !/^[A-Za-z]/.test(p)) break;
    const total = iT > -1 ? num_(v[i][hc + iT]) : 0;
    const real = iR > -1 ? num_(v[i][hc + iR]) : 0;
    ringkas.push({
      program: p,
      total: total,
      realisasi: real,
      tsgo: iTs > -1 ? num_(v[i][hc + iTs]) : 0,
      belumMasuk: iB > -1 ? num_(v[i][hc + iB]) : 0,
      konservasi: iK > -1 ? num_(v[i][hc + iK]) : 0,
      lainnya: iL > -1 ? num_(v[i][hc + iL]) : 0,
      pct: total > 0 ? real / total * 100 : 0
    });
  }

  const bulan = {}, detail = {};
  let detailHead = [];
  try {
    const vals = sheet_(ss, namaDetail).getDataRange().getDisplayValues();
    const headAsli = vals[0];
    const headN = headAsli.map(norm_);
    const rows = vals.slice(1);
    const iP = col_(headN, 'program'), iKat = col_(headN, 'kategori status');
    const iRen = col_(headN, 'no bln rencana'), iPro = col_(headN, 'no bln produksi');

    let tampil = KOLOM_TAMPIL.map(function (n) { return col_(headN, n); })
                             .filter(function (i) { return i > -1; });
    if (!tampil.length) {
      for (let i = 0; i < headN.length && tampil.length < 8; i++) if (headN[i]) tampil.push(i);
    }
    detailHead = tampil.map(function (i) { return headAsli[i]; });

    // Kolom tanggal (header diawali "Tgl") diseragamkan formatnya: 23-Mei-26
    const kolTgl = tampil.filter(function (i) { return /^tgl/.test(headN[i]); });

    if (iP > -1 && iKat > -1 && iRen > -1 && iPro > -1) {
      rows.forEach(function (r) {
        const p = String(r[iP] || '').trim();
        if (!p) return;
        if (!bulan[p]) {
          bulan[p] = { rencana: new Array(12).fill(0), realisasi: new Array(12).fill(0) };
          detail[p] = [];
        }
        const mr = Math.round(num_(r[iRen])), mp = Math.round(num_(r[iPro]));
        const real = norm_(r[iKat]) === 'realisasi';
        if (mr >= 1 && mr <= 12) bulan[p].rencana[mr - 1]++;
        if (real && mp >= 1 && mp <= 12) bulan[p].realisasi[mp - 1]++;
        detail[p].push({
          c: tampil.map(function (i) { return kolTgl.indexOf(i) > -1 ? rapikanTgl_(r[i]) : r[i]; }),
          mr: mr, mp: mp, real: real
        });
      });
    }
  } catch (e) { /* grafik bulanan opsional */ }

  // Hitung ulang ringkasan dari baris detail supaya sinkron dengan tabel unit
  if (Object.keys(detail).length) {
    const hit = {};
    Object.keys(detail).forEach(function (p) {
      const c = { total: 0, realisasi: 0, tsgo: 0, belumMasuk: 0, konservasi: 0, lainnya: 0 };
      detail[p].forEach(function (r) {
        c.total++;
        const t = r.c.join(' ').toLowerCase();
        if (r.real) c.realisasi++;
        else if (/tsgo/.test(t)) c.tsgo++;
        else if (/konservasi|geser/.test(t)) c.konservasi++;
        else if (/belum/.test(t)) c.belumMasuk++;
        else c.lainnya++;
      });
      hit[norm_(p)] = c;
    });
    const jml = { total: 0, realisasi: 0, tsgo: 0, belumMasuk: 0, konservasi: 0, lainnya: 0 };
    let baris = null;
    ringkas.forEach(function (r) {
      if (norm_(r.program) === 'total') { baris = r; return; }
      const c = hit[norm_(r.program)];
      if (!c) return;
      Object.keys(jml).forEach(function (k) { r[k] = c[k]; jml[k] += c[k]; });
      r.pct = r.total > 0 ? r.realisasi / r.total * 100 : 0;
    });
    if (baris) {
      Object.keys(jml).forEach(function (k) { baris[k] = jml[k]; });
      baris.pct = baris.total > 0 ? baris.realisasi / baris.total * 100 : 0;
    }
  }
  return { ringkas: ringkas, bulan: bulan, detail: detail, detailHead: detailHead };
}

function getNusantara_(ss) {
  const v = sheet_(ss, SH.NUS_SUM).getDataRange().getDisplayValues();
  const cari = function (awalan) {
    for (let i = 0; i < v.length; i++) {
      for (let j = 0; j < v[i].length; j++) {
        if (norm_(v[i][j]).indexOf(awalan) === 0) {
          for (let k = j + 1; k < v[i].length; k++) {
            if (String(v[i][k]).trim() !== '') return String(v[i][k]).trim();
          }
        }
      }
    }
    return '';
  };
  const kpi = {
    aktual: cari('rata-rata aktual'),
    rencana: cari('rata-rata program'),
    deviasi: cari('deviasi'),
    selesai: cari('kereta selesai')
  };
  kpi.aktualNum = num_(kpi.aktual);
  kpi.rencanaNum = num_(kpi.rencana);
  kpi.deviasiNum = num_(kpi.deviasi);
  kpi.selesaiNum = num_(kpi.selesai);

  const t = readTable_(ss, SH.NUS, 1), h = t.head;
  const iK = need_(col_(h, 'kereta'), 'Kereta / Pekerjaan', SH.NUS);
  const iG = col_(h, 'kelompok'), iPos = col_(h, 'posisi data'), iRen = col_(h, 'rencana kumulatif'),
        iAk = col_(h, 'aktual kumulatif'), iDev = col_(h, 'deviasi'), iSisa = col_(h, 'sisa'), iSt = col_(h, 'status');
  const items = [];
  t.rows.forEach(function (r) {
    const k = String(r[iK] || '').trim();
    if (!k) return;
    items.push({
      kereta: k,
      kelompok: iG > -1 ? r[iG] : '',
      posisi: iPos > -1 ? r[iPos] : '',
      rencana: iRen > -1 ? num_(r[iRen]) : 0,
      aktual: iAk > -1 ? num_(r[iAk]) : 0,
      deviasi: iDev > -1 ? num_(r[iDev]) : 0,
      sisa: iSisa > -1 ? num_(r[iSisa]) : 0,
      status: iSt > -1 ? r[iSt] : ''
    });
  });

  // Hitung "Kereta selesai 100%" langsung dari tabel (bukan dari sel sheet ringkasan)
  const nSelesai = items.filter(function (x) {
    return norm_(x.status) === 'selesai' || x.aktual >= 99.995;
  }).length;
  kpi.selesai = String(nSelesai);
  kpi.selesaiNum = nSelesai;

  const kurva = [];
  try {
    const kv = sheet_(ss, SH.KURVA).getDataRange().getDisplayValues();
    const head = kv[1].map(norm_);
    const iP = head.indexOf('periode');
    const iR = head.findIndex(function (x) { return x.indexOf('rata-rata rencana') === 0; });
    const iA = head.findIndex(function (x) { return x.indexOf('rata-rata aktual') === 0; });
    if (iP > -1 && iR > -1 && iA > -1) {
      for (let i = 2; i < kv.length; i++) {
        const p = String(kv[i][iP] || '').trim();
        if (!p) continue;
        kurva.push({
          periode: p,
          rencana: String(kv[i][iR]).trim() === '' ? null : num_(kv[i][iR]),
          aktual: String(kv[i][iA]).trim() === '' ? null : num_(kv[i][iA])
        });
      }
    }
  } catch (e) { /* kurva S opsional */ }

  return { kpi: kpi, items: items, kurva: kurva };
}

function getSukuCadang_(ss) {
  const t = readTable_(ss, SH.SPARE, 1), h = t.head, S = SH.SPARE;
  const iM = col_(h, 'matnum'), iSum = col_(h, 'sumber');
  const iJ = need_(col_(h, 'judul pengadaan'), 'Judul Pengadaan', S);
  const iD = col_(h, 'deskripsi material'), iSat = col_(h, 'satuan'), iQ = col_(h, 'qty');
  const iH = col_(h, 'harga satuan'), iTot = need_(col_(h, 'jumlah harga'), 'Jumlah Harga', S);
  const iV = col_(h, 'vendor');

  const daftar = [];
  if (iV < 0) {
    try {
      const p = readTable_(ss, SH.PENGADAAN, 1);
      const pD = col_(p.head, 'deskripsi pekerjaan'), pV = col_(p.head, 'vendor');
      if (pD > -1 && pV > -1) {
        p.rows.forEach(function (r) {
          const d = norm_(r[pD]), v = String(r[pV] || '').trim();
          if (d && v) daftar.push([d, v]);
        });
      }
    } catch (e) { /* vendor opsional */ }
  }
  const cariVendor = buatCariVendor_(daftar);

  const rows = [], perSumber = {};
  let total = 0;
  t.rows.forEach(function (r) {
    if (!String(r[iJ] || '').trim() && !String(iM > -1 ? r[iM] : '').trim()) return;
    const jml = num_(r[iTot]);
    total += jml;
    const s = iSum > -1 ? (String(r[iSum]).trim() || 'Lainnya') : 'Lainnya';
    if (!perSumber[s]) perSumber[s] = { baris: 0, nilai: 0 };
    perSumber[s].baris++;
    perSumber[s].nilai += jml;
    const vendor = (iV > -1 ? String(r[iV] || '').trim() : cariVendor(r[iJ])) || '(belum ada vendor)';
    rows.push([
      iM > -1 ? r[iM] : '', r[iJ], vendor, iD > -1 ? r[iD] : '', iSat > -1 ? r[iSat] : '',
      iQ > -1 ? num_(r[iQ]) : 0, iH > -1 ? num_(r[iH]) : 0
    ]);
  });
  return { total: total, jumlahBaris: rows.length, perSumber: perSumber, rows: rows };
}

/** Pencari vendor berdasarkan judul pengadaan (dipakai 2026 dan 2025). */
function buatCariVendor_(daftar) {
  const memo = {};
  return function (judul) {
    const j = norm_(judul);
    if (!j) return '';
    if (memo[j] !== undefined) return memo[j];
    let hasil = '';
    for (let i = 0; i < daftar.length && !hasil; i++) if (daftar[i][0] === j) hasil = daftar[i][1];
    if (!hasil && j.length >= 20) {
      for (let i = 0; i < daftar.length && !hasil; i++) {
        if (daftar[i][0].indexOf(j) > -1 || j.indexOf(daftar[i][0]) > -1) hasil = daftar[i][1];
      }
    }
    memo[j] = hasil;
    return hasil;
  };
}


