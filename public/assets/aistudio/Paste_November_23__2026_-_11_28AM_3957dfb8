/* ======================================================================
 *  INPUT DATA DARI DASHBOARD (Pengadaan, Program, Suku Cadang, APAR)
 * ====================================================================== */
const LOG_INPUT = 'LOG INPUT';

function inputTh_(t) { t = String(t); return ['2025', '2026', '2027'].indexOf(t) > -1 ? t : '2026'; }
function inputAdmin_(token) {
  const r = peran_(token);
  if (!r) throw new Error('SESI_HABIS');
  if (r !== 'admin') throw new Error('Hanya Admin yang boleh menginput data.');
}
function inputSS_(th) { return SpreadsheetApp.openById(th === '2025' ? SS_ID_2025 : (th === '2027' ? SS_ID_2027 : SS_ID)); }

/** Daftar sheet tujuan tiap modul. kunci = kolom wajib; unik = kombinasi kolom yang dicek duplikat. */
function inputTargets_(modul, th) {
  const s25 = th === '2025';
  const T = {
    pengadaan: s25 ? [{ sheet: SH25.PENGADAAN, kunci: 'deskripsi' }] : [{ sheet: SH.PENGADAAN, kunci: 'deskripsi pekerjaan' }],
    program: [{ sheet: s25 ? SH25.PROGRAM : SH.PROGRAM, kunci: 'no sarana', unik: ['no sarana', 'program'] }],
    suku: s25
      ? [{ sheet: SH25.SUKCAD_KONTRAK, kunci: 'judul pengadaan' }, { sheet: SH25.SUKCAD_UMDS, kunci: 'pengadaan' }]
      : [{ sheet: SH.SPARE, kunci: 'judul pengadaan' }],
    apar: s25 ? [] : [{ sheet: APAR_NAMA_SHEET, kunci: 'no. apar', unik: ['no. apar'], sub: true }]
  };
  return T[modul] || [];
}

function inputKepala_(sh, t) {
  const lastCol = sh.getLastColumn();
  if (lastCol < 1) throw new Error('Sheet "' + t.sheet + '" kosong');
  const top = sh.getRange(1, 1, Math.min(15, Math.max(sh.getLastRow(), 2)), lastCol).getDisplayValues();
  let hr = 0;
  if (t.sub) {
    hr = -1;
    for (let i = 0; i < top.length && hr < 0; i++) {
      if (top[i].some(function (c) { return norm_(c) === t.kunci; })) hr = i;
    }
    if (hr < 0) throw new Error('Header "' + t.kunci + '" tidak ditemukan di sheet "' + t.sheet + '"');
  }
  const h1 = top[hr], h2 = t.sub ? (top[hr + 1] || []) : [];
  const sub = t.sub && h2.some(function (x) { return norm_(x) === 'pressure'; });
  const label = h1.map(function (x, j) { return String((sub && h2[j]) || x || '').trim(); });
  return { label: label, norm: label.map(norm_), mulai: hr + (sub ? 2 : 1) + 1, lastCol: lastCol };
}

function inputSkema_(sh, t) {
  const k = inputKepala_(sh, t);
  const lastRow = sh.getLastRow();
  const n = Math.max(0, Math.min(300, lastRow - k.mulai + 1));
  let vals = [], frm = [];
  if (n > 0) {
    const rg = sh.getRange(lastRow - n + 1, 1, n, k.lastCol);
    vals = rg.getValues(); frm = rg.getFormulas();
  }
  const kcol = col_(k.norm, t.kunci);
  const fields = [];
  for (let j = 0; j < k.lastCol; j++) {
    if (!k.label[j]) continue;
    const kol = vals.map(function (r) { return r[j]; });
    const nb = kol.filter(function (v) { return v !== '' && v !== null; });
    const strs = nb.filter(function (v) { return typeof v === 'string'; });
    const nF = frm.filter(function (r) { return r[j]; }).length;
    const formula = n > 0 && nF >= n * 0.5;
    const dates = nb.filter(function (v) { return v instanceof Date; }).length;
    const nums = nb.filter(function (v) { return typeof v === 'number'; }).length;
    let tipe = 'teks', fmt = '', opsi = [];
    if (nb.length && dates >= nb.length * 0.5) { tipe = 'tgl'; fmt = 'date'; }
    else if (nb.length && nums >= nb.length * 0.6) { tipe = 'angka'; }
    else if (strs.length && /tgl|tanggal|kadaluarsa|pengecekan/.test(k.norm[j])) {
      const full = strs.filter(function (s) { return parseTgl_(s); }).length;
      const bln = strs.filter(function (s) { return /^[A-Za-z]+[-\s\/.]\d{2,4}$/.test(s.trim()); }).length;
      if (full >= strs.length * 0.5) { tipe = 'tgl'; fmt = 'text'; }
      else if (bln >= strs.length * 0.5) { tipe = 'bulan'; fmt = 'text'; }
    }
    if (tipe === 'teks' && !formula) {
      const seen = {}; strs.forEach(function (s) { if (s.trim()) seen[s.trim()] = 1; });
      const d = Object.keys(seen);
      if (d.length && d.length <= 40 && strs.length >= d.length * 1.5) opsi = d.sort(function (a, b) { return a.localeCompare(b, 'id'); });
    }
    fields.push({ i: j, label: k.label[j], tipe: tipe, fmt: fmt, opsi: opsi, formula: formula, wajib: j === kcol });
  }
  // 8 baris terakhir, hanya kolom input pertama (untuk pratinjau)
  const vis = fields.filter(function (f) { return !f.formula; }).slice(0, 7);
  let terakhir = [];
  if (lastRow >= k.mulai) {
    const r0 = Math.max(k.mulai, lastRow - 7), nr = lastRow - r0 + 1;
    const d = sh.getRange(r0, 1, nr, k.lastCol).getDisplayValues();
    terakhir = d.map(function (r) { return vis.map(function (f) { return r[f.i]; }); });
  }
  return { fields: fields, pratinjauKepala: vis.map(function (f) { return f.label; }), terakhir: terakhir, mulai: k.mulai, kcol: kcol };
}

/** Dipanggil dari Index.html. Hanya Admin. */
function getInputSkema(token, tahun, modul, idx) {
  inputAdmin_(token);
  const th = inputTh_(tahun);
  const tg = inputTargets_(modul, th);
  if (!tg.length) return { targets: [], pesan: 'Modul ini tidak tersedia untuk tahun ' + th + '.' };
  const t = tg[Math.min(Math.max(+idx || 0, 0), tg.length - 1)];
  const sh = sheet_(inputSS_(th), t.sheet);
  const s = inputSkema_(sh, t);
  return { targets: tg.map(function (x, i) { return { idx: i, nama: x.sheet }; }), idx: Math.min(Math.max(+idx || 0, 0), tg.length - 1), sheet: t.sheet, skema: s };
}

function inputTulisNilai_(f, v) {
  if (v === '' || v === null || v === undefined) return '';
  v = String(v).trim();
  if (f.tipe === 'angka') { const n = num_(v.replace(/\./g, '').replace(',', '.')) ; const p = parseFloat(String(v).replace(',', '.')); return isNaN(p) ? n : p; }
  if (f.tipe === 'tgl') {
    const m = v.match(/^(\d{4})-(\d{2})-(\d{2})$/); if (!m) return v;
    return f.fmt === 'date' ? new Date(+m[1], +m[2] - 1, +m[3]) : (+m[3]) + '-' + BLN_PENDEK_[+m[2] - 1] + '-' + m[1].slice(-2);
  }
  if (f.tipe === 'bulan') {
    const m = v.match(/^(\d{4})-(\d{2})$/); if (!m) return v;
    return BLN_PENDEK_[+m[2] - 1] + '-' + m[1].slice(-2);
  }
  return v;
}

/** Hapus cache dashboard tahun tertentu (dipanggil setelah input / edit / hapus data). */
function hapusCache_(th) {
  const c = CacheService.getScriptCache(), key = CACHE_VERSI_ + th;
  const n = parseInt(c.get(key + '_n') || '0', 10), ks = [key + '_n'];
  for (let i = 0; i < n; i++) ks.push(key + '_' + i);
  c.removeAll(ks);
}

/** data = { indexKolom: nilai }. paksa=true melewati peringatan duplikat. */
function simpanInput(token, tahun, modul, idx, data, paksa) {
  inputAdmin_(token);
  const th = inputTh_(tahun);
  const tg = inputTargets_(modul, th);
  const t = tg[+idx || 0];
  if (!t) throw new Error('Sheet tujuan tidak ditemukan.');
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { ok: false, pesan: 'Server sedang dipakai orang lain. Coba lagi sebentar lagi.' };
  try {
    const ss = inputSS_(th), sh = sheet_(ss, t.sheet);
    const k = inputKepala_(sh, t), sk = inputSkema_(sh, t);
    const F = {}; sk.fields.forEach(function (f) { F[f.i] = f; });
    const isi = {};
    Object.keys(data || {}).forEach(function (i) {
      const f = F[i]; if (!f || f.formula) return;
      const v = inputTulisNilai_(f, data[i]);
      if (v !== '') isi[i] = v;
    });
    // validasi wajib
    for (let a = 0; a < sk.fields.length; a++) {
      const f = sk.fields[a];
      if (f.wajib && (isi[f.i] === undefined)) return { ok: false, pesan: 'Kolom "' + f.label + '" wajib diisi.' };
    }
    // tanggal keluar tidak boleh lebih awal dari tanggal masuk
    let masuk = null, keluar = null;
    sk.fields.forEach(function (f) {
      if (f.tipe !== 'tgl' || isi[f.i] === undefined) return;
      const d = (isi[f.i] instanceof Date) ? isi[f.i] : (function () { const p = parseTgl_(isi[f.i]); return p ? new Date(p.y, p.m - 1, p.d) : null; })();
      if (!d) return;
      const l = norm_(f.label);
      if (/masuk/.test(l)) masuk = d; else if (/keluar/.test(l)) keluar = d;
    });
    if (masuk && keluar && keluar < masuk) return { ok: false, pesan: 'Tanggal keluar tidak boleh lebih awal dari tanggal masuk.' };

    const lastRow = sh.getLastRow();
    const n = Math.max(1, lastRow - k.mulai + 1);
    // cek duplikat
    if (t.unik && !paksa) {
      const ci = t.unik.map(function (u) { return col_(k.norm, u); });
      if (ci.every(function (x) { return x > -1; }) && lastRow >= k.mulai) {
        const d = sh.getRange(k.mulai, 1, n, k.lastCol).getDisplayValues();
        const kini = ci.map(function (x) { return norm_(isi[x] instanceof Date ? '' : (isi[x] || '')); });
        const ada = d.some(function (r) { return ci.every(function (x, q) { return norm_(r[x]) === kini[q]; }); });
        if (ada) return { ok: false, duplikat: true, pesan: 'Data dengan ' + t.unik.join(' + ') + ' yang sama sudah ada di sheet.' };
      }
    }
    // baris kosong berikutnya, berdasarkan kolom kunci
    let baris = lastRow + 1;
    if (sk.kcol > -1 && lastRow >= k.mulai) {
      const kv = sh.getRange(k.mulai, sk.kcol + 1, n, 1).getValues();
      let last = -1; kv.forEach(function (r, q) { if (String(r[0]).trim() !== '') last = q; });
      baris = k.mulai + last + 1;
    }
    const prev = baris - 1;
    if (sh.getMaxRows() < baris) sh.insertRowsAfter(sh.getMaxRows(), baris - sh.getMaxRows());
    // salin format baris sebelumnya
    if (prev >= k.mulai) sh.getRange(prev, 1, 1, k.lastCol).copyTo(sh.getRange(baris, 1, 1, k.lastCol), SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
    // salin rumus (bukan ARRAYFORMULA)
    sk.fields.forEach(function (f) {
      if (!f.formula || prev < k.mulai) return;
      const src = sh.getRange(prev, f.i + 1), dst = sh.getRange(baris, f.i + 1);
      const fx = src.getFormula();
      if (fx && fx.toUpperCase().indexOf('ARRAYFORMULA') < 0 && !dst.getFormula()) src.copyTo(dst, SpreadsheetApp.CopyPasteType.PASTE_FORMULA, false);
    });
    // tulis nilai input
    Object.keys(isi).forEach(function (i) { sh.getRange(baris, +i + 1).setValue(isi[i]); });
    SpreadsheetApp.flush();

    // log
    let lg = ss.getSheetByName(LOG_INPUT);
    if (!lg) { lg = ss.insertSheet(LOG_INPUT); lg.appendRow(['Waktu', 'Peran', 'Tahun', 'Modul', 'Sheet', 'Baris', 'Data']); lg.setFrozenRows(1); }
    const ringkas = {}; Object.keys(isi).forEach(function (i) { ringkas[F[i].label] = isi[i] instanceof Date ? Utilities.formatDate(isi[i], Session.getScriptTimeZone(), 'yyyy-MM-dd') : isi[i]; });
    lg.appendRow([new Date(), 'admin', th, modul, t.sheet, baris, JSON.stringify(ringkas)]);

    hapusCache_(th);
    return { ok: true, pesan: 'Tersimpan di sheet "' + t.sheet + '" baris ' + baris + '.', skema: inputSkema_(sh, t) };
  } finally { lock.releaseLock(); }
}

/* ======================================================================
 *  EDIT & HAPUS DATA DARI DASHBOARD
 * ====================================================================== */
function inputTarget_(modul, th, idx) {
  const t = inputTargets_(modul, th)[+idx || 0];
  if (!t) throw new Error('Sheet tujuan tidak tersedia untuk modul/tahun ini.');
  return t;
}

function inputLog_(ss, th, aksi, modul, sheetName, baris, obj) {
  let lg = ss.getSheetByName(LOG_INPUT);
  if (!lg) { lg = ss.insertSheet(LOG_INPUT); lg.appendRow(['Waktu', 'Peran', 'Tahun', 'Modul', 'Sheet', 'Baris', 'Data']); lg.setFrozenRows(1); }
  lg.appendRow([new Date(), 'admin', th, modul + ' · ' + aksi, sheetName, baris, JSON.stringify(obj)]);
}

/** Pastikan baris yang akan diubah masih baris yang sama dengan yang dilihat admin. */
function inputKunci_(sh, k, sk, baris, kunciAsli) {
  if (sk.kcol < 0) throw new Error('Kolom kunci sheet tidak ditemukan.');
  baris = +baris;
  if (!(baris >= k.mulai) || baris > sh.getLastRow()) throw new Error('Baris tidak valid. Muat ulang daftar lalu coba lagi.');
  const cur = String(sh.getRange(baris, sk.kcol + 1).getDisplayValue() || '').trim();
  if (!cur || norm_(cur) !== norm_(kunciAsli)) {
    throw new Error('Isi baris sudah berubah (mungkin ada yang mengedit atau menghapusnya). Muat ulang daftar lalu coba lagi.');
  }
}

function inputTglObj_(v) {
  if (v instanceof Date) return v;
  if (v === '' || v === null || v === undefined) return null;
  const p = parseTgl_(String(v));
  return p ? new Date(p.y, p.m - 1, p.d) : null;
}

/** Nilai sel -> nilai untuk form (yyyy-MM-dd, yyyy-MM, angka, atau teks). */
function inputNilaiForm_(f, v, disp) {
  if (v === '' || v === null || v === undefined) return '';
  const tz = Session.getScriptTimeZone();
  if (f.tipe === 'tgl') {
    const d = inputTglObj_(v);
    return d ? Utilities.formatDate(d, tz, 'yyyy-MM-dd') : '';
  }
  if (f.tipe === 'bulan') {
    if (v instanceof Date) return Utilities.formatDate(v, tz, 'yyyy-MM');
    const m = String(v).match(/^([A-Za-z]+)[-\s\/.](\d{2,4})$/);
    const b = m && BLN_MAP_[m[1].toLowerCase()];
    if (!b) return '';
    let y = +m[2]; if (y < 100) y += 2000;
    return y + '-' + ('0' + b).slice(-2);
  }
  if (f.tipe === 'angka') return typeof v === 'number' ? v : num_(v);
  return String(disp !== undefined ? disp : v);
}

/** Daftar baris sheet (terbaru di atas) untuk tabel edit. Hanya Admin. */
function getInputBaris(token, tahun, modul, idx, cari, hal) {
  inputAdmin_(token);
  const th = inputTh_(tahun), tg = inputTargets_(modul, th);
  if (!tg.length) return { targets: [], pesan: 'Modul ini tidak tersedia untuk tahun ' + th + '.' };
  const ix = Math.min(Math.max(+idx || 0, 0), tg.length - 1), t = tg[ix];
  const sh = sheet_(inputSS_(th), t.sheet), k = inputKepala_(sh, t), sk = inputSkema_(sh, t);
  if (sk.kcol < 0) throw new Error('Kolom kunci sheet "' + t.sheet + '" tidak ditemukan.');
  const vis = sk.fields.filter(function (f) { return !f.formula; }).slice(0, 7);
  const lastRow = sh.getLastRow(), n = lastRow - k.mulai + 1;
  const qs = norm_(cari || ''), rows = [];
  if (n > 0) {
    const d = sh.getRange(k.mulai, 1, n, k.lastCol).getDisplayValues();
    for (let r = d.length - 1; r >= 0; r--) {
      const row = d[r], kv = String(row[sk.kcol] || '').trim();
      if (!kv) continue;
      if (qs && !row.some(function (c) { return norm_(c).indexOf(qs) > -1; })) continue;
      rows.push({ r: k.mulai + r, k: kv, c: vis.map(function (f) { return row[f.i]; }) });
    }
  }
  const PS = 20, total = rows.length, pages = Math.max(1, Math.ceil(total / PS));
  const h = Math.min(Math.max(+hal || 0, 0), pages - 1);
  return {
    targets: tg.map(function (x, i) { return { idx: i, nama: x.sheet }; }), idx: ix, sheet: t.sheet,
    fields: sk.fields, kepala: vis.map(function (f) { return f.label; }),
    total: total, hal: h, pages: pages, rows: rows.slice(h * PS, h * PS + PS)
  };
}

/** Nilai satu baris untuk mengisi form edit. */
function getInputRow(token, tahun, modul, idx, baris, kunciAsli) {
  inputAdmin_(token);
  const th = inputTh_(tahun), t = inputTarget_(modul, th, idx);
  const sh = sheet_(inputSS_(th), t.sheet), k = inputKepala_(sh, t), sk = inputSkema_(sh, t);
  inputKunci_(sh, k, sk, baris, kunciAsli);
  const rg = sh.getRange(+baris, 1, 1, k.lastCol), v = rg.getValues()[0], d = rg.getDisplayValues()[0], out = {};
  sk.fields.forEach(function (f) { if (!f.formula) out[f.i] = inputNilaiForm_(f, v[f.i], d[f.i]); });
  return out;
}

/** data = hanya kolom yang berubah { indexKolom: nilai }. Nilai kosong = hapus isi sel. */
function updateInput(token, tahun, modul, idx, baris, kunciAsli, data) {
  inputAdmin_(token);
  const th = inputTh_(tahun), t = inputTarget_(modul, th, idx);
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new Error('Server sedang dipakai orang lain. Coba lagi sebentar lagi.');
  try {
    const ss = inputSS_(th), sh = sheet_(ss, t.sheet), k = inputKepala_(sh, t), sk = inputSkema_(sh, t);
    inputKunci_(sh, k, sk, baris, kunciAsli);
    baris = +baris;
    const F = {}; sk.fields.forEach(function (f) { F[f.i] = f; });
    const baru = {};
    Object.keys(data || {}).forEach(function (i) {
      const f = F[i]; if (!f || f.formula) return;
      baru[i] = inputTulisNilai_(f, data[i]);
    });
    if (!Object.keys(baru).length) throw new Error('Tidak ada perubahan untuk disimpan.');
    if (baru[sk.kcol] === '') throw new Error('Kolom "' + F[sk.kcol].label + '" wajib diisi.');

    const rg = sh.getRange(baris, 1, 1, k.lastCol), rowV = rg.getValues()[0], rowD = rg.getDisplayValues()[0];
    let masuk = null, keluar = null;
    sk.fields.forEach(function (f) {
      if (f.tipe !== 'tgl') return;
      const d = inputTglObj_(baru[f.i] !== undefined ? baru[f.i] : rowV[f.i]); if (!d) return;
      const l = norm_(f.label);
      if (/masuk/.test(l)) masuk = d; else if (/keluar/.test(l)) keluar = d;
    });
    if (masuk && keluar && keluar < masuk) throw new Error('Tanggal keluar tidak boleh lebih awal dari tanggal masuk.');

    const tz = Session.getScriptTimeZone(), sebelum = {}, sesudah = {};
    Object.keys(baru).forEach(function (i) {
      const cell = sh.getRange(baris, +i + 1), v = baru[i];
      sebelum[F[i].label] = rowD[i];
      if (v === '') cell.clearContent(); else cell.setValue(v);
      sesudah[F[i].label] = v instanceof Date ? Utilities.formatDate(v, tz, 'yyyy-MM-dd') : v;
    });
    SpreadsheetApp.flush();
    inputLog_(ss, th, 'EDIT', modul, t.sheet, baris, { sebelum: sebelum, sesudah: sesudah });
    hapusCache_(th);
    return { ok: true, pesan: 'Perubahan tersimpan di sheet "' + t.sheet + '" baris ' + baris + '.' };
  } finally { lock.releaseLock(); }
}

function hapusInput(token, tahun, modul, idx, baris, kunciAsli) {
  inputAdmin_(token);
  const th = inputTh_(tahun), t = inputTarget_(modul, th, idx);
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) throw new Error('Server sedang dipakai orang lain. Coba lagi sebentar lagi.');
  try {
    const ss = inputSS_(th), sh = sheet_(ss, t.sheet), k = inputKepala_(sh, t), sk = inputSkema_(sh, t);
    inputKunci_(sh, k, sk, baris, kunciAsli);
    baris = +baris;
    const d = sh.getRange(baris, 1, 1, k.lastCol).getDisplayValues()[0], isi = {};
    sk.fields.forEach(function (f) { if (d[f.i] !== '') isi[f.label] = d[f.i]; });
    sh.deleteRow(baris);
    SpreadsheetApp.flush();
    inputLog_(ss, th, 'HAPUS', modul, t.sheet, baris, isi);
    hapusCache_(th);
    return { ok: true, pesan: 'Baris ' + baris + ' dihapus dari sheet "' + t.sheet + '". Isinya tersimpan di LOG INPUT.' };
  } finally { lock.releaseLock(); }
}/* ======================================================================
 *  DIAGNOSA SELISIH TOTAL DOKUMEN PENGADAAN (dashboard vs RINGKASAN)
 *  Hasil ditulis ke sheet "DIAGNOSA PENGADAAN". Tidak mengubah data lain.
 * ====================================================================== */
function diagnosaPengadaan() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const t = readTable_(ss, SH.PENGADAAN, 1), h = t.head;
  const iDesk = col_(h, 'deskripsi pekerjaan'), iTipe = col_(h, 'tipe pengadaan');
  const iTgl = col_(h, 'tgl spk'), iSt = col_(h, 'status'), iKat = col_(h, 'kategori');
  const iNo = col_(h, 'no dok'), iBln = col_(h, 'bulan kontrak');
  if (iDesk < 0) throw new Error('Kolom "Deskripsi Pekerjaan" tidak ditemukan');

  const g = function (r, i) { return i > -1 ? String(r[i] || '').trim() : ''; };
  const perTipe = {}, perStatus = {}, aneh = [], kunciDok = {}, dobel = [];
  let totalDash = 0, cocokFilter = 0;

  t.rows.forEach(function (r, i) {
    const d = g(r, iDesk);
    if (!d || barisTotal_(d)) return;
    totalDash++;
    const baris = i + 2;
    const tipe = g(r, iTipe), tglTxt = g(r, iTgl), noDok = g(r, iNo);

    perTipe[tipe || '(KOSONG)'] = (perTipe[tipe || '(KOSONG)'] || 0) + 1;

    const stTxt = g(r, iKat) || g(r, iSt);
    const kat = katPbj_(stTxt);
    const kS = '[' + stTxt + '] → ' + kat;
    perStatus[kS] = (perStatus[kS] || 0) + 1;

    // alasan baris ini mungkin tidak masuk hitungan RINGKASAN
    const alasan = [];
    const tipeBaku = /^(spk|umds|kontrak)$/i.test(tipe);
    if (!tipeBaku) alasan.push(tipe ? 'tipe tidak baku' : 'tipe kosong');
    const tg = parseTgl_(tglTxt);
    let bln = iBln > -1 ? Math.round(num_(r[iBln])) : 0;
    if (!(bln >= 1 && bln <= 12) && tg && tg.y === 2026) bln = tg.m;
    if (!tg && !(bln >= 1)) alasan.push('tanggal kosong/tidak terbaca');
    else if (tg && tg.y !== 2026) alasan.push('tahun ' + tg.y);
    else if (bln > 11) alasan.push('di luar Jan–Nov');
    if (!alasan.length) cocokFilter++;
    else aneh.push([baris, noDok, tipe, tglTxt, stTxt, kat, alasan.join(', '), d.slice(0, 60)]);

    // cek duplikat No Dokumen
    if (noDok) {
      if (kunciDok[noDok]) dobel.push([baris, noDok, 'sama dengan baris ' + kunciDok[noDok], d.slice(0, 60)]);
      else kunciDok[noDok] = baris;
    }
  });

  let sh = ss.getSheetByName('DIAGNOSA PENGADAAN');
  if (!sh) sh = ss.insertSheet('DIAGNOSA PENGADAAN'); else sh.clear();
  const out = [];
  out.push(['DIAGNOSA PENGADAAN — dibuat ' + new Date().toLocaleString('id-ID')]);
  out.push(['Total baris dihitung dashboard (Deskripsi terisi)', totalDash]);
  out.push(['Baris dgn tipe SPK/UMDS/KONTRAK & periode Jan–Nov 2026', cocokFilter]);
  out.push(['Baris yang kemungkinan tidak masuk RINGKASAN', aneh.length]);
  out.push(['No Dokumen ganda', dobel.length]);
  out.push(['']);
  out.push(['PER TIPE PENGADAAN (apa adanya, dalam kurung siku)']);
  Object.keys(perTipe).forEach(function (k) { out.push(['[' + k + ']', perTipe[k]]); });
  out.push(['']);
  out.push(['STATUS (teks asli) → KATEGORI dashboard']);
  Object.keys(perStatus).forEach(function (k) { out.push([k, perStatus[k]]); });
  out.push(['']);
  out.push(['BARIS YANG PERLU DICEK']);
  out.push(['Baris', 'No Dok', 'Tipe', 'Tgl SPK', 'Status', 'Kategori', 'Alasan', 'Deskripsi']);
  aneh.forEach(function (a) { out.push(a); });
  out.push(['']);
  out.push(['NO DOKUMEN GANDA']);
  out.push(['Baris', 'No Dok', 'Keterangan', 'Deskripsi']);
  dobel.forEach(function (a) { out.push(a); });

  const lebar = out.reduce(function (m, r) { return Math.max(m, r.length); }, 1);
  const rata = out.map(function (r) { const c = r.slice(); while (c.length < lebar) c.push(''); return c; });
  sh.getRange(1, 1, rata.length, lebar).setValues(rata);
  sh.getRange(1, 1).setFontWeight('bold');
  sh.autoResizeColumns(1, Math.min(lebar, 8));
  ss.setActiveSheet(sh);
  SpreadsheetApp.getUi().alert('Selesai. Dashboard menghitung ' + totalDash + ' baris; ' +
    aneh.length + ' baris kemungkinan tidak masuk RINGKASAN. Lihat sheet "DIAGNOSA PENGADAAN".');
}// ===== SCAN PDF RAB =====
const MODEL = 'gemini-4-hydrogen'; // jika error "model not found", ganti sesuai daftar model di AI Studio
const SHEET_HASIL = 'HASIL SCAN RAB';
const KOLOM_REKAP = ['No Dok','Deskripsi Pekerjaan','Deskripsi CI','Jenis Pengadaan (LEL/PDL)','Tipe Pengadaan','Vendor','Netto RAB (Rp)','Nilai SPK/Kontrak / UMDS (Rp)','Tgl SPK/Kontrak/ UMDS','Posisi Berkas','Status','Tgl RAB','File Sumber','Cek Total'];
const KOLOM_ITEM = ['No','Matnum','Nama Barang','Spesifikasi Teknik','Satuan','Rencana','Harga Satuan (Rp)','Jumlah Harga TDP (Rp)','Jumlah Harga Non TDP (Rp)','Ket'];

function onOpen() {
  SpreadsheetApp.getUi().createMenu('📄 Scan RAB')
    .addItem('Upload PDF RAB', 'bukaUploadPdf')
    .addItem('Atur API Key', 'aturApiKey')
    .addToUi();
}

function aturApiKey() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('API Key Gemini', 'Tempel API key dari Google AI Studio:', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() === ui.Button.OK && r.getResponseText().trim()) {
    PropertiesService.getScriptProperties().setProperty('GEMINI_API_KEY', r.getResponseText().trim());
    ui.alert('API key tersimpan.');
  }
}

function bukaUploadPdf() {
  const html = HtmlService.createHtmlOutputFromFile('UploadPdf').setWidth(420).setHeight(260);
  SpreadsheetApp.getUi().showModalDialog(html, 'Scan PDF RAB');
}

function prosesPdf(base64, namaFile) {
  const key = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  if (!key) throw new Error('API key belum diatur. Menu Scan RAB > Atur API Key.');

  const prompt =
    'Ini dokumen RENCANA BIAYA (RAB). Baca seluruh isinya dan balas HANYA JSON valid tanpa teks lain, format: ' +
    '{"no_dok":"","jenis":"","deskripsi_pekerjaan":"","tgl_rab":"YYYY-MM-DD","netto":0,' +
    '"item":[{"no":0,"matnum":"","nama_barang":"","spesifikasi":"","satuan":"","rencana":0,"harga_satuan":0,"jumlah_tdp":0,"jumlah_non_tdp":0,"ket":""}]}. ' +
    'Aturan: no_dok = angka nomor urut pada "Nomor : KR / <angka> / ..." (hanya angkanya). ' +
    'jenis = PDL atau LEL sesuai kode pada nomor tersebut, kosongkan jika tidak ada. ' +
    'deskripsi_pekerjaan = judul RAB lengkap. ' +
    'netto = nilai "JUMLAH (NETTO)" sebelum PPN. Semua angka berupa number murni tanpa "Rp" dan tanpa pemisah ribuan. ' +
    'Baris judul kelompok (mis. "Kit Maintenance") bukan item. Jika teks bukan Bahasa Indonesia, terjemahkan ke Bahasa Indonesia. ' +
    'Jika suatu nilai tidak ada, isi string kosong atau 0; jangan menebak.';

  const res = UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/' + MODEL + ':generateContent', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { 'x-goog-api-key': key },
    payload: JSON.stringify({
      contents: [{ parts: [
        { inline_data: { mime_type: 'application/pdf', data: base64 } },
        { text: prompt }
      ]}],
      generationConfig: { responseMimeType: 'application/json' }
    })
  });
  const body = JSON.parse(res.getContentText());
  if (res.getResponseCode() !== 200) throw new Error((body.error && body.error.message) || 'Gagal memanggil API');
  if (!body.candidates || !body.candidates[0] || !body.candidates[0].content) throw new Error('AI tidak mengembalikan hasil. Coba lagi.');
  const teks = body.candidates[0].content.parts.map(p => p.text || '').join('').replace(/```json|```/g, '').trim();
  const d = JSON.parse(teks);

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const aman = v => (typeof v === 'string' && v.charAt(0) === '=') ? "'" + v : v;
  const items = d.item || [];
  const total = items.reduce((s, i) => s + (Number(i.jumlah_tdp) || 0) + (Number(i.jumlah_non_tdp) || 0), 0);
  const netto = Number(d.netto) || 0;
  const cek = (netto && Math.abs(total - netto) < 1) ? 'OK' : 'Total item (' + total + ') tidak sama dengan Netto, cek manual';
  const tgl = /^\d{4}-\d{2}-\d{2}$/.test(d.tgl_rab || '') ? new Date(d.tgl_rab + 'T00:00:00') : '';

  let hasil = ss.getSheetByName(SHEET_HASIL);
  if (!hasil) {
    hasil = ss.insertSheet(SHEET_HASIL);
    hasil.getRange(1, 1, 1, KOLOM_REKAP.length).setValues([KOLOM_REKAP])
      .setFontWeight('bold').setBackground('#1F4E79').setFontColor('#FFFFFF').setWrap(true);
    hasil.setFrozenRows(1);
  }
  const noDok = isNaN(Number(d.no_dok)) || d.no_dok === '' ? aman(d.no_dok || '') : Number(d.no_dok);
  hasil.appendRow([noDok, aman(d.deskripsi_pekerjaan || ''), '', d.jenis || '', '', '', netto || '', '', '', '', '', tgl, namaFile, cek]);
  const br = hasil.getLastRow();
  hasil.getRange(br, 7).setNumberFormat('"Rp"#,##0');
  hasil.getRange(br, 12).setNumberFormat('d-MMM-yy');
  hasil.getRange(br, 1, 1, KOLOM_REKAP.length).setBorder(true, true, true, true, true, true);
  if (br === 2) hasil.autoResizeColumns(1, KOLOM_REKAP.length);

  let nama = ('RAB ' + (d.no_dok || namaFile.replace(/\.pdf$/i, ''))).replace(/[\[\]\*\?\/\\:]/g, '').substring(0, 90);
  if (ss.getSheetByName(nama)) nama += ' ' + Utilities.formatDate(new Date(), 'Asia/Jakarta', 'ddMM-HHmm');
  const sh = ss.insertSheet(nama);
  sh.getRange(1, 1).setValue(d.deskripsi_pekerjaan || nama).setFontWeight('bold').setFontSize(12);
  sh.getRange(3, 1, 1, KOLOM_ITEM.length).setValues([KOLOM_ITEM])
    .setFontWeight('bold').setBackground('#1F4E79').setFontColor('#FFFFFF').setWrap(true);
  if (items.length) {
    const rows = items.map(i => [i.no, aman(i.matnum || ''), aman(i.nama_barang || ''), aman(i.spesifikasi || ''), i.satuan || '',
      i.rencana, i.harga_satuan, i.jumlah_tdp, i.jumlah_non_tdp, aman(i.ket || '')]);
    sh.getRange(4, 1, rows.length, KOLOM_ITEM.length).setValues(rows).setBorder(true, true, true, true, true, true);
    sh.getRange(4, 7, rows.length, 3).setNumberFormat('#,##0');
  }
  const tr = 4 + items.length;
  sh.getRange(tr, 3).setValue('JUMLAH (NETTO)').setFontWeight('bold');
  sh.getRange(tr, 8).setValue(netto).setNumberFormat('#,##0').setFontWeight('bold');
  sh.autoResizeColumns(1, KOLOM_ITEM.length);

  ss.setActiveSheet(hasil);
  return 'Baris ditambahkan ke "' + SHEET_HASIL + '" dan sheet "' + nama + '" dibuat. Cek Total: ' + cek;
}