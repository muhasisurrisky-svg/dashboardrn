/* ---------------------------- Helper ---------------------------- */

/** Teks angka format Indonesia ("Rp1.234,50", "94,3%", "-0,2%", "5.110") -> number. */
function num_(v) {
  if (typeof v === 'number') return v;
  if (v === null || v === undefined) return 0;
  let s = String(v).replace(/Rp/gi, '').replace(/[%\s]/g, '');
  if (!s || s === '-') return 0;
  let neg = false;
  if (s.charAt(0) === '-' || (s.charAt(0) === '(' && s.slice(-1) === ')')) {
    neg = true;
    s = s.replace(/[-()]/g, '');
  }
  if (s.indexOf(',') > -1) {
    s = s.replace(/\./g, '').replace(',', '.');
  } else if (/^\d{1,3}(\.\d{3})+$/.test(s)) {
    s = s.replace(/\./g, '');
  }
  const n = parseFloat(s);
  if (isNaN(n)) return 0;
  return neg ? -n : n;
}

function norm_(s) {
  return String(s === null || s === undefined ? '' : s).replace(/\s+/g, ' ').trim().toLowerCase();
}

/** Klasifikasi status pengadaan. "Belum selesai" / "Belum cair" tidak dihitung Selesai. */
function katPbj_(s) {
  s = norm_(s);
  if (/gagal|batal/.test(s)) return 'Gagal/Batal';
  if (/\b(belum|tidak|bukan)\b/.test(s)) return 'Dalam Proses';
  if (/selesai|\bclosed?\b|cair/.test(s)) return 'Selesai';
  return 'Dalam Proses';
}

/** Seragamkan penulisan nama vendor: huruf besar, spasi rapi, "PT." -> "PT". */
function rapiVendor_(s) {
  s = String(s || '').replace(/\s+/g, ' ').trim().toUpperCase();
  return s.replace(/^(PT|CV|UD)\.?\s+/, '$1 ').replace(/\s*,\s*/g, ', ');
}

/** Baris yang isinya hanya "Total", "Jumlah", "Subtotal", atau "Grand total". */
function barisTotal_(s) {
  return /^(grand\s*total|sub\s*total|total|jumlah)\s*:?$/i.test(String(s || '').trim());
}

function sheet_(ss, nama) {
  const sh = ss.getSheetByName(nama);
  if (!sh) throw new Error('Sheet "' + nama + '" tidak ditemukan');
  return sh;
}

function readTable_(ss, nama, headerRow) {
  const vals = sheet_(ss, nama).getDataRange().getDisplayValues();
  const h = (headerRow || 1) - 1;
  if (!vals[h]) throw new Error('Sheet "' + nama + '" kosong atau baris header tidak ada');
  return { head: vals[h].map(norm_), rows: vals.slice(h + 1) };
}

function col_(head, nama) {
  const n = norm_(nama);
  let i = head.indexOf(n);
  if (i > -1) return i;
  i = head.findIndex(function (x) { return x.indexOf(n) === 0; });
  if (i > -1) return i;
  return head.findIndex(function (x) { return x.indexOf(n) > -1; });
}

function need_(idx, nama, sheetName) {
  if (idx < 0) throw new Error('Kolom "' + nama + '" tidak ditemukan di sheet "' + sheetName + '"');
  return idx;
}

const BLN_MAP_ = { jan:1, feb:2, mar:3, apr:4, mei:5, may:5, jun:6, jul:7, agu:8, agt:8, aug:8, sep:9, sept:9,
  okt:10, oct:10, nov:11, des:12, dec:12, januari:1, februari:2, maret:3, april:4, juni:6, juli:7,
  agustus:8, september:9, oktober:10, november:11, desember:12 };

/** "16-Des-24", "30 Juni 2025", "16/12/2024" -> {d, m, y}. Gagal -> null. */
function parseTgl_(s) {
  s = String(s || '').trim();
  let m = s.match(/^(\d{1,2})[-\s]([A-Za-z]+)[-\s](\d{2,4})/);
  if (m) {
    const b = BLN_MAP_[m[2].toLowerCase()];
    if (b) { let y = +m[3]; if (y < 100) y += 2000; return { d: +m[1], m: b, y: y }; }
  }
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if (m) return { d: +m[1], m: +m[2], y: +m[3] };
  return null;
}

const BLN_PENDEK_ = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];

/** "23/05/2026" / "6-Agu-26" -> "23-Mei-26". Kalau bukan tanggal, dikembalikan apa adanya. */
function rapikanTgl_(s) {
  const t = parseTgl_(s);
  if (!t) return String(s === null || s === undefined ? '' : s).trim();
  return t.d + '-' + BLN_PENDEK_[t.m - 1] + '-' + String(t.y).slice(-2);
}

