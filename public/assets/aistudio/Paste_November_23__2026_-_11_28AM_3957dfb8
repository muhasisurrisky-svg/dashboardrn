    nilaiRab += rab; nilaiPerjanjian += nil; if (isBatal) batal++;
    perStatus[status] = (perStatus[status] || 0) + 1;
    perTipe[tipe] = (perTipe[tipe] || 0) + 1;
    rows.push([get(r, iNo), get(r, iNama), tipe, get(r, iMitra), rab, hps, nil,
               get(r, iTgl), get(r, iNoK), get(r, iMppl), status, get(r, iKet)]);
  });
  return { total: rows.length, nilaiRab: nilaiRab, nilaiPerjanjian: nilaiPerjanjian,
           batal: batal, perStatus: perStatus, perTipe: perTipe, rows: rows };
}

/* ============ CACHE DATA DASHBOARD (agar buka lebih ringan) ============ */
var CACHE_DETIK_ = 1800;      // 30 menit
var CACHE_POTONG_ = 90000;    // karakter per potongan (base64 = ASCII, aman di bawah batas 100 KB)
// Naikkan angka versi ini (v6, v7, ...) setiap kali struktur data diubah, supaya cache lama tidak terpakai.
var CACHE_VERSI_ = 'dash_v6_';

/** Data digzip lalu dipotong. Teks dengan huruf non-ASCII tidak lagi melewati batas 100 KB. */
function cacheGetBesar_(key) {
  try {
    var c = CacheService.getScriptCache();
    var meta = c.get(key + '_n');
    if (!meta) return null;
    var n = parseInt(meta, 10), keys = [];
    for (var i = 0; i < n; i++) keys.push(key + '_' + i);
    var got = c.getAll(keys), b64 = '';
    for (var j = 0; j < n; j++) {
      if (got[keys[j]] == null) return null;
      b64 += got[keys[j]];
    }
    var blob = Utilities.newBlob(Utilities.base64Decode(b64), 'application/x-gzip', 'd.gz');
    return JSON.parse(Utilities.ungzip(blob).getDataAsString());
  } catch (e) { return null; }
}

function cachePutBesar_(key, obj) {
  try {
    var c = CacheService.getScriptCache();
    var gz = Utilities.gzip(Utilities.newBlob(JSON.stringify(obj), 'application/octet-stream', 'd'));
    var b64 = Utilities.base64Encode(gz.getBytes());
    var n = Math.ceil(b64.length / CACHE_POTONG_), batch = {};
    if (n > 90) return; // terlalu besar: jalan tanpa cache
    for (var i = 0; i < n; i++) batch[key + '_' + i] = b64.substr(i * CACHE_POTONG_, CACHE_POTONG_);
    batch[key + '_n'] = String(n);
    c.putAll(batch, CACHE_DETIK_);
  } catch (e) { /* abaikan, tetap jalan tanpa cache */ }
}

/** Admin dapat memaksa refresh; User hanya membaca cache/data yang tersedia. */
function getDashboardData(token, tahun, paksa) {
  const role = peran_(token);
  if (!role) throw new Error('SESI_HABIS');
  const th = ['2025', '2026', '2027'].indexOf(String(tahun)) > -1 ? String(tahun) : '2026';
  const key = CACHE_VERSI_ + th;
  let hasil = null;
  if (!(paksa === true && role === 'admin')) hasil = cacheGetBesar_(key);
  if (!hasil) {
    hasil = getDashboardDataAsli_(token, th);
    cachePutBesar_(key, hasil);
  }
  return untukPeran_(hasil, role);
}


