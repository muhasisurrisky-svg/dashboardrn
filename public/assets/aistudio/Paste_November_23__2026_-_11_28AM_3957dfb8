  const iNo = col_(h, 'no'), iNama = need_(col_(h, 'nama pengadaan'), 'NAMA PENGADAAN', S);
  const iRab = col_(h, 'nilai rab'), iHps = col_(h, 'nilai hps'), iNil = col_(h, 'nilai perjanjian');
  const iMitra = col_(h, 'mitra'), iTgl = col_(h, 'tgl kontrak'), iNoK = col_(h, 'no. kontrak');
  const iMppl = col_(h, 'mppl'), iKet = col_(h, 'keterangan');
  const iTipe = col_(h, 'tipe pengadaan'), iProg = col_(h, 'progres');
  const mulai = [iTipe, iProg].filter(function (i) { return i > -1; });
  const dari = mulai.length ? Math.min.apply(null, mulai) : 0;
  const get = function (r, i) { return i > -1 ? String(r[i] || '').trim() : ''; };

  const rows = [], perStatus = {}, perTipe = {};
  let nilaiRab = 0, nilaiPerjanjian = 0, batal = 0;
  t.rows.forEach(function (r) {
    if (!get(r, iNama)) return;
    const ekor = r.slice(dari).join(' ');
    const isBatal = /batal|gagal/i.test(ekor);
    const status = isBatal ? 'BATAL' : (get(r, iProg) || '-');
    let tipe = get(r, iTipe);
