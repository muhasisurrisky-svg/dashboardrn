    : '';
  return hasil;
}

/** "Jun-26", "Dec-2028", "30 Juni 2026", "30/06/2026" -> Date. */
function aparParseTgl_(s) {
  s = String(s || '').trim();
  if (!s) return null;
  const m = s.match(/^([A-Za-z]+)[-\s\/.](\d{2,4})$/);
  if (m) {
    const b = BLN_MAP_[m[1].toLowerCase()];
    if (b) {
      let y = +m[2];
      if (y < 100) y += 2000;
      return new Date(y, b, 0);
    }
  }
  const t = parseTgl_(s);
  return t ? new Date(t.y, t.m - 1, t.d) : null;
}

function aparBaca_(ss) {
  const S = APAR_NAMA_SHEET;
  const vals = sheet_(ss, S).getDataRange().getDisplayValues();

  // Header utama "NO. APAR"; subheader pemeriksaan berada di baris berikutnya.
  let hr = -1;
  for (let i = 0; i < Math.min(vals.length, 15) && hr < 0; i++) {
    if (vals[i].some(function (c) { return norm_(c) === 'no. apar'; })) hr = i;
  }
  if (hr < 0) throw new Error('Header "NO. APAR" tidak ditemukan di sheet "' + S + '"');
  const h1 = vals[hr].map(norm_);
  const h2 = (vals[hr + 1] || []).map(norm_);
  const sub = h2.some(function (x) { return x === 'pressure'; });
  const head = h1.map(function (x, j) { return (sub && h2[j]) || x; });

  const iNo = need_(col_(head, 'no. apar'), 'NO. APAR', S);
  const iLok = need_(col_(head, 'lokasi'), 'LOKASI', S);
  const iKad = need_(col_(head, 'kadaluarsa'), 'KADALUARSA', S);
  const iJen = col_(head, 'jenis');
  const iKap = col_(head, 'kapasitas');
  const iCek = col_(head, 'tanggal terakhir pengecekan');
  const iPre = col_(head, 'pressure');
  const iSeg = col_(head, 'segel');
  const iSel = col_(head, 'selang');
  const iTab = col_(head, 'kondisi tabung');
  const iTem = col_(head, 'tempat');
  const iBar = col_(head, 'barcode');
  const iNext = col_(head, 'kadaluarsa berikutnya');

  const get = function (r, i) { return i > -1 ? String(r[i] || '').trim() : ''; };
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const perStatus = { 'Aman': 0, 'Segera kadaluarsa': 0, 'Kadaluarsa': 0, 'Tidak ada data': 0 };
  const bulanMap = {};
  const rows = [];
  let tanpaLokasi = 0, sudahCek = 0, sudahGanti = 0;

  vals.slice(hr + (sub ? 2 : 1)).forEach(function (r) {
    const no = get(r, iNo), lok = get(r, iLok);
    if (!no && !lok) return;
    const kad = get(r, iKad), nxt = get(r, iNext), cek = get(r, iCek), bar = get(r, iBar);

    // APAR yang sudah diganti memakai "kadaluarsa berikutnya".
    const tgl = aparParseTgl_(nxt || kad);
    let status = 'Tidak ada data', sisa = '';
    if (tgl) {
      sisa = Math.round((tgl.getTime() - today.getTime()) / 86400000);
      status = sisa < 0 ? 'Kadaluarsa' : (sisa <= APAR_BATAS_HARI ? 'Segera kadaluarsa' : 'Aman');
      const key = tgl.getFullYear() * 100 + tgl.getMonth() + 1;
      if (!bulanMap[key]) {
        bulanMap[key] = {
          key: key,
          label: BULAN_ID[tgl.getMonth()].slice(0, 3) + ' ' + tgl.getFullYear(),
          n: 0,
          lewat: tgl < today
        };
      }
      bulanMap[key].n++;
    }
    perStatus[status]++;
    if (!lok) tanpaLokasi++;
    if (cek) sudahCek++;
    if (bar || nxt) sudahGanti++;

    rows.push([
      no, lok, get(r, iJen), get(r, iKap), kad, cek,
      get(r, iPre), get(r, iSeg), get(r, iSel), get(r, iTab), get(r, iTem),
      bar, nxt, status, sisa
    ]);
  });

  return {
    total: rows.length,
    tanpaLokasi: tanpaLokasi,
    sudahCek: sudahCek,
    sudahGanti: sudahGanti,
    batasHari: APAR_BATAS_HARI,
    acuan: today.getDate() + ' ' + BULAN_ID[today.getMonth()] + ' ' + today.getFullYear(),
    perStatus: perStatus,
    perBulan: Object.keys(bulanMap)
      .map(function (k) { return bulanMap[k]; })
      .sort(function (a, b) { return a.key - b.key; }),
    rows: rows
  };
}

