@keyframes pgUp{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:none}}
@keyframes pgDown{from{opacity:0;transform:translateY(-32px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.tab.on.pg-up,.tab.on.pg-down{animation:none!important}}

/* 3. Interaksi grafik gaya Tailwind (hover: scale, brightness, shadow, dim) */
.hb,.ci2,.bl2 .r,.dn2 li{transition:transform .2s ease,background .2s ease}
.hb .tr,.bl2 .bx,.pbar,.pt2{transition:transform .2s ease}
.hb .tr i,.pbar i,.pt2 i,.bl2 .m,.ring .v,.dn2 .sg{transition:filter .2s ease,opacity .2s ease,box-shadow .2s ease}
.hb:hover{transform:translateX(4px)}
.hb:hover .tr,.ci2:hover .pt2,.kpi2:hover .pbar,.bl2 .r:hover .bx{transform:scaleY(1.35)}
.hb:hover .tr i,.ci2:hover .pt2 i,.kpi2:hover .pbar i,.bl2 .r:hover .m{filter:brightness(1.15) saturate(1.15);box-shadow:0 3px 12px rgba(47,82,179,.35)}
.ci2:hover{transform:translateX(4px)}
.bl2 .r{cursor:pointer}
.dn2 .sg{cursor:pointer}
.dn2:has(.sg:hover) .sg:not(:hover){opacity:.4}
