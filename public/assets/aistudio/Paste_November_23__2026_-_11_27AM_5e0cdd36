.bl2 .ax .sc{position:relative;height:12px;font-size:10.5px;color:var(--mute)}
.bl2 .ax .sc span{position:absolute;top:0;transform:translateX(-50%)}
.bl2 .ax .sc span:first-child{transform:none}
.bl2 .r{cursor:pointer;border-radius:10px;padding:5px 0;transition:background .2s}
.bl2 .r:hover{background:var(--soft)}
.bl2 .nm{min-width:0}
.bl2 .nm b{display:block;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bl2 .nm small{display:block;font-size:11.5px;color:var(--mute);white-space:nowrap}
.bl2 .bb{display:flex;flex-direction:column;gap:6px;min-width:0}
.bl2 .bx{position:relative;height:18px}
.bl2 .z{position:absolute;top:0;height:18px}
.bl2 .z1{left:0;width:80%;border-radius:6px 0 0 6px;background:rgba(229,72,77,.2);background:color-mix(in srgb,var(--red) 22%,transparent)}
.bl2 .z2{left:80%;width:15%;background:rgba(245,154,27,.24);background:color-mix(in srgb,var(--amber) 26%,transparent)}
.bl2 .z3{left:95%;width:5%;border-radius:0 6px 6px 0;background:rgba(18,168,116,.24);background:color-mix(in srgb,var(--green) 26%,transparent)}
.bl2 .m{position:absolute;left:0;top:5px;height:8px;border-radius:4px;background:var(--blue);transform-origin:left;animation:gw 1.1s cubic-bezier(.2,.8,.2,1) backwards}
.bl2 .tg{position:absolute;left:95%;top:-3px;width:3px;height:24px;margin-left:-1px;border-radius:2px;background:var(--ink)}
.bl2 .ct{display:flex;flex-wrap:wrap;gap:2px 10px;font-size:11px;color:var(--ink2)}
.bl2 .ct span{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.bl2 .ct i{width:7px;height:7px;border-radius:50%;flex:none}
.bl2 .pv{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.bl2 .pv b{font-size:18px;line-height:1;color:var(--ci,var(--mute))}
.bl2 .pv .st{padding:2px 8px;font-size:10.5px}
.dn2{display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:6px}
.dn2 .ring2{position:relative;width:150px;height:150px}
.dn2 svg{display:block;width:100%;height:100%}
.dn2 .sg{animation:dgrow .9s cubic-bezier(.2,.8,.2,1) backwards}
@keyframes dgrow{from{stroke-width:0}}
.dn2 .ctr{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}
.dn2 .ctr b{font-size:17px;letter-spacing:-.3px}
.dn2 .ctr span{font-size:11.5px;color:var(--mute)}
.dn2 ul{list-style:none;margin:0;padding:0;width:100%}
.dn2 li{display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid var(--line);font-size:12.5px}
.dn2 li:last-child{border-bottom:0;padding-bottom:0}
.dn2 li i{width:11px;height:11px;border-radius:4px;flex:none}
.dn2 li .n{flex:1;font-weight:600;color:var(--ink)}
.dn2 li .p{font-size:11.5px;color:var(--mute)}
.dn2 li b{min-width:70px;text-align:right}
.kpi2 .spk{position:absolute;right:18px;top:48px;width:90px;height:41px;pointer-events:none}
@media(prefers-reduced-motion:reduce){.bl2 .m,.dn2 .sg{animation:none!important}}
