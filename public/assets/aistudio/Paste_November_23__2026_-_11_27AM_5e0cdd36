#tb-pbj .tw::-webkit-scrollbar-thumb,#tb-sc .tw::-webkit-scrollbar-thumb,#t-pengadaan .tw.mini::-webkit-scrollbar-thumb{background:var(--line);border-radius:6px}
#tb-pbj .tw::-webkit-scrollbar-thumb:hover,#t-pengadaan .tw.mini::-webkit-scrollbar-thumb:hover{background:var(--mute)}
/* baris kedua Pengadaan: donut mengisi tinggi kartu, sama padatnya dengan grafik di atasnya */
@media(min-width:900px){
  #t-pengadaan .cols2>.card:has(#p-nilai){display:flex;flex-direction:column}
  #t-pengadaan .cols2>.card:has(#p-nilai) .chartbox{flex:1 1 auto;height:auto;min-height:240px}
  #t-pengadaan .cols2>.card:has(#p-nilai) .chartbox canvas{position:absolute;left:0;top:0}
}
</style>
<script>
(function () {
  /* ---- 5. pindahkan filter triwulan ke bawah info update (kiri header) ---- */
  var hr = document.querySelector('.hright'), tgl = document.getElementById('tgl'), tw = document.getElementById('tw-bar');
  if (hr && tgl && tw && !hr.querySelector('.hleft')) {
    var col = document.createElement('div'); col.className = 'hleft';
    hr.insertBefore(col, tgl); col.appendChild(tgl); col.appendChild(tw);
  }

  /* ---- 2. transisi halaman: ke atas / ke bawah ---- */
  function order() { return [].slice.call(document.querySelectorAll('#nav button')).map(function (b) { return b.getAttribute('data-t'); }); }
  var on0 = document.querySelector('#nav button.on'), last = on0 ? on0.getAttribute('data-t') : null;
  if (typeof showTab === 'function') {
    var st = showTab;
    showTab = function (t) {
      var o = order(), from = o.indexOf(last), to = o.indexOf(t);
      var r = st.apply(this, arguments);
      var el = document.getElementById('t-' + t);
      if (el && t !== last) {
        el.classList.remove('pg-up', 'pg-down'); void el.offsetWidth;
        el.classList.add(to >= from ? 'pg-up' : 'pg-down');
        clearTimeout(el._pg); el._pg = setTimeout(function () { el.classList.remove('pg-up', 'pg-down'); }, 520);
      }
      last = t;
      return r;
    };
  }

  /* ---- 3 & 4. interaksi + ukuran grafik (Chart.js) ---- */
  if (typeof Chart === 'undefined') return;
  var D = Chart.defaults;
  D.font.size = 13; D.font.weight = 500;
  D.transitions.active.animation.duration = 220;
  D.transitions.active.animation.easing = 'easeOutCubic';
  D.elements.arc.hoverOffset = 12;
  D.elements.point.hoverRadius = 7; D.elements.point.hitRadius = 14; D.elements.point.hoverBorderWidth = 3;
  D.plugins.tooltip.titleFont = { size: 14, weight: '700' };
  D.plugins.tooltip.bodyFont = { size: 13 };
  D.plugins.tooltip.padding = 12; D.plugins.tooltip.boxPadding = 5;
  D.plugins.legend.labels.font = { size: 13 };

  Chart.register({
    id: 'twHover',
    afterUpdate: function (ch) {
      var t = ch.config.type;
      if (['bar', 'doughnut', 'pie', 'polarArea'].indexOf(t) < 0) return;
      ch.data.datasets.forEach(function (_, di) {
        ch.getDatasetMeta(di).data.forEach(function (el) {
          if (el.$tw) return; el.$tw = 1;
          var d = el.draw;
          el.draw = function () {
            var c = arguments[0], act = ch.getActiveElements ? ch.getActiveElements() : [];
            var on = act.some(function (x) { return x.element === el; });
            var dim = act.length && !on;
            c.save();
            if (dim) c.globalAlpha = .4;
            if (on) { c.shadowColor = 'rgba(20,36,63,.32)'; c.shadowBlur = 16; c.shadowOffsetY = 5; }
            d.apply(el, arguments);
            c.restore();
          };
        });
      });
    },
    beforeDatasetsDraw: function (ch) {
      if (ch.config.type !== 'line') return;
      var act = ch.getActiveElements ? ch.getActiveElements() : []; if (!act.length) return;
      var x = act[0].element.x, a = ch.chartArea, c = ch.ctx;
      c.save(); c.strokeStyle = 'rgba(120,140,180,.55)'; c.lineWidth = 1; c.setLineDash([4, 4]);
      c.beginPath(); c.moveTo(x, a.top); c.lineTo(x, a.bottom); c.stroke(); c.restore();
    },
    afterEvent: function (ch) {
      ch.canvas.style.cursor = (ch.getActiveElements && ch.getActiveElements().length) ? 'pointer' : 'default';
    }
  });
})();
</script>

