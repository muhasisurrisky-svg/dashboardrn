.dn2 li{font-size:14px}
.dn2 li .p,.dn2 .ctr span{font-size:13px}
.dn2 .ctr b{font-size:19px}
.kpi2 .line,.k2f{font-size:13px}

/* 5. Filter triwulan di header kiri, tepat di bawah baris "Update Program" */
.hleft{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}
