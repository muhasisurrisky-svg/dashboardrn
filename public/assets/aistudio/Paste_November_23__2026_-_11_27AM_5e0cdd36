<script>
(function(){
  if(typeof RENDER==='undefined'||typeof showTab!=='function') return;
  try{ FONT='"Inter","Segoe UI",Helvetica,Arial,sans-serif'; Chart.defaults.font.family=FONT; }catch(e){}
  var CMP=true, PREV=null, PREVY=null, KVM='unit', KVT='all', KVREG={}, PBM='dok', KVP='';
  function dark(){return document.documentElement.getAttribute('data-theme')==='dark';}
  function SKY(){return dark()?'#5BC8FA':'#38BDF8';}
  function PLAN(){return dark()?'#9DB2FF':'#2F52B3';}
  function stt(p){return p>=95?['s-ok','Tercapai']:(p>=80?['s-warn','Peringatan']:['s-bad','Perlu Perhatian']);}
  function pY(){var y=(+TAHUN)-1;return y>=2025?String(y):null;}
  function inkVar(){return getComputedStyle(document.documentElement).getPropertyValue('--ink').trim()||'#14243F';}

  function met(d){
    var m={}; if(!d) return m;
    if(d.anggaran&&d.anggaran.total) m.ang=d.anggaran.total.pct;
    if(d.pengadaan) m.pbj=d.pengadaan.pctSelesai;
    if(d.program&&d.program.ringkas){var r=0,t=0; d.program.ringkas.forEach(function(x){if(kunci(x.program)==='total')return;r+=x.realisasi;t+=x.total;}); if(t) m.prog=r/t*100;}
    if(d.nusantara&&d.nusantara.kpi) m.nus=d.nusantara.kpi.aktualNum;
    return m;
  }
  function applyDelta(){
    var py=pY(), cur=met(D), pre=PREV?met(PREV):{};
    ['ang','pbj','prog','nus'].forEach(function(id){
      var e=document.getElementById('dl-'+id); if(!e) return;
      if(!CMP||!py||pre[id]==null||cur[id]==null||isNaN(pre[id])||isNaN(cur[id])){e.textContent='';return;}
      var d=cur[id]-pre[id];
      e.style.color=d>=0?'var(--g-ink)':'var(--r-ink)';
      e.textContent=(d>=0?'▲ ':'▼ ')+fmtP(Math.abs(d),1).replace('%','')+' poin vs '+py;
    });
  }
  function loadPrev(){
    var py=pY(); if(!py||!CMP){applyDelta();return;}
    if(PREV&&PREVY===py){applyDelta();return;}
    try{
      google.script.run.withSuccessHandler(function(d){ if(pY()!==py) return; PREV=d; PREVY=py; applyDelta(); })
        .withFailureHandler(function(){applyDelta();}).getDashboardData(TOKEN,py,false);
    }catch(e){applyDelta();}
  }

  function kpi2(id,t,val,line,foot,footc,p){
    var s=stt(p), w=Math.max(0,Math.min(100,+p||0));
    return '<div class="card kpi2 '+s[0]+'"><div class="k2t"><span>'+t+'</span><span class="st"><i></i>'+s[1]+'</span></div>'+
      '<div class="big">'+val+'</div><div class="line">'+line+'</div>'+
      '<div class="pbar" title="Batas status: 80% dan 95%"><i style="width:'+w+'%"></i><u style="left:80%"></u><u style="left:95%"></u></div>'+
      '<div class="k2f"><b style="color:'+footc+'">'+foot+'</b><span class="dl" id="dl-'+id+'"></span></div></div>';
  }

  function fmtRpM(v){return 'Rp'+v.toLocaleString('id-ID',{minimumFractionDigits:1,maximumFractionDigits:1})+' M';}
  function fmtUnit(v){return fmtInt(v)+' unit';}
  function kvCardHtml(id,title,hint,ctrl){
    return '<div class="card kvcard" style="margin-bottom:18px"><div class="kvh"><div><h3>'+title+'</h3><div class="hint">'+hint+'</div></div><div class="kvc">'+(ctrl||'')+'</div></div><div class="kvsum" id="'+id+'-sum"></div><div class="chartbox" style="height:300px"><canvas id="'+id+'"></canvas></div></div>';
  }
  /* Kurva S generik: build() -> {labels, r, z, fmt, yTitle, dec, yMax, rName, zName}. Mengikuti filter periode global. */
  function kvDraw(id,build){
    KVREG[id]=build;
    var cv=document.getElementById(id); if(!cv) return;
    var sp=build(); if(!sp) return;
    var lab=sp.labels.slice(), cr=sp.r.slice(), cz=sp.z.slice(), fm=sp.fmt, rn=sp.rName||'Rencana', zn=sp.zName||'Realisasi';
    if(lab.length===12){
      var a0=KVT==='all'?0:(+KVT-1)*3, b0=KVT==='all'?11:a0+2;
      lab=lab.slice(a0,b0+1); cr=cr.slice(a0,b0+1); cz=cz.slice(a0,b0+1);
    }
    var last=-1; cz.forEach(function(v,i){if(v!=null) last=i;});
    var sm=document.getElementById(id+'-sum');
    if(sm){
      if(last<0||cr[last]==null){ sm.innerHTML=''; }
      else {
        var r=cr[last], z=cz[last], d=z-r, pc=r>0?z/r*100:0, s2=stt(pc);
        sm.innerHTML='<div class="kvs"><span>'+esc(rn)+' per '+esc(lab[last])+'</span><b>'+fm(r)+'</b></div>'+
          '<div class="kvs"><span>'+esc(zn)+'</span><b>'+fm(z)+'</b></div>'+
          '<div class="kvs"><span>Selisih</span><b style="color:'+(d<0?'var(--r-ink)':'var(--g-ink)')+'">'+(d<0?'−':'+')+fm(Math.abs(d))+'</b></div>'+
          '<div class="kvs"><span>Pencapaian</span><b>'+fmtP(pc,1)+'</b><span class="st '+s2[0]+'"><i></i>'+s2[1]+'</span></div>';
      }
    }
    var dev={id:'devBadge',afterDatasetsDraw:function(ch){
      if(last<0||cr[last]==null) return;
      var m0=ch.getDatasetMeta(0).data[last], m1=ch.getDatasetMeta(1).data[last]; if(!m0||!m1) return;
      var d=cz[last]-cr[last], col=d<0?C_RED:C_GREEN, ctx=ch.ctx;
      ctx.save(); ctx.strokeStyle=col; ctx.lineWidth=2.4; ctx.beginPath(); ctx.moveTo(m0.x,m0.y); ctx.lineTo(m1.x,m1.y); ctx.stroke();
      var txt=(d<0?'−':'+')+fm(Math.abs(d)); ctx.font='bold 14px '+FONT;
      var w=ctx.measureText(txt).width+16, x=m0.x+10, y=Math.max(m0.y,m1.y)+4;
      if(x+w>ch.width-4) x=m0.x-w-10;
      ctx.fillStyle=hexA(col,.18); ctx.beginPath(); if(ctx.roundRect) ctx.roundRect(x,y,w,24,12); else ctx.rect(x,y,w,24); ctx.fill();
      ctx.fillStyle=col; ctx.textBaseline='middle'; ctx.fillText(txt,x+8,y+12); ctx.restore();
    }};
    mkChart(id,{type:'line',
      data:{labels:lab,datasets:[
        {label:rn,data:cr,borderColor:PLAN(),borderDash:[7,5],backgroundColor:PLAN(),tension:.3,pointRadius:0,pointHoverRadius:4,borderWidth:2.4},
        {label:zn,data:cz,borderColor:C_GREEN,borderWidth:3,tension:.3,pointRadius:3,pointBackgroundColor:'#fff',pointBorderColor:C_GREEN,fill:true,
          backgroundColor:function(c){var a=c.chart.chartArea; if(!a) return hexA(C_GREEN,.2); var g=c.chart.ctx.createLinearGradient(0,a.top,0,a.bottom); g.addColorStop(0,hexA(C_GREEN,.32)); g.addColorStop(1,hexA(C_GREEN,0)); return g;}}]},
      options:{responsive:true,maintainAspectRatio:false,layout:{padding:{right:60}},interaction:{mode:'index',intersect:false},
        scales:{y:{beginAtZero:true,suggestedMax:sp.yMax,ticks:{precision:sp.dec||0},title:{display:true,text:sp.yTitle||''}},x:{grid:{display:false}}},
        plugins:{legend:{position:'bottom',labels:{boxWidth:10,boxHeight:10,font:{size:13}}},tooltip:{callbacks:{
          label:function(c){return ' '+c.dataset.label+': '+(c.parsed.y==null?'-':fm(c.parsed.y));},
          afterBody:function(it){var i=it[0].dataIndex; if(cz[i]==null||cr[i]==null) return ''; var d=cz[i]-cr[i]; return 'Selisih '+(d>=0?'+':'−')+fm(Math.abs(d));}}}}},
      plugins:[dev]});
  }

  function renderDash(){
