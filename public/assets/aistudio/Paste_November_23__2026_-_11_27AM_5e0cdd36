  var go=function(d){
    var order=visibleTabs(), i=order.indexOf(cur())+d;
    if(i<0) i=order.length-1; if(i>=order.length) i=0;
    showTab(order[i]); rz();
  };
  var enter=function(){
    document.body.classList.add('pres'); setZ(Z);
    var d=document.documentElement, rq=d.requestFullscreen||d.webkitRequestFullscreen;
    try{ if(rq&&document.fullscreenEnabled!==false){ var r=rq.call(d); if(r&&r.catch) r.catch(function(){}); } }catch(e){}
    rz();
  };
  var leave=function(){
    document.body.classList.remove('pres'); document.documentElement.style.removeProperty('--pz');
    try{ if(document.fullscreenElement) document.exitFullscreen(); }catch(e){}
