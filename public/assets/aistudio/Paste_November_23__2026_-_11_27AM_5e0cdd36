<!-- ===== PATCH DONUT KOMPOSISI PROGRAM (SAMA DENGAN NILAI KONTRAK) ===== -->
<script>
(function(){
  function dn2Ring(vals, cols, R, sw){
    var C = 2 * Math.PI * R, tot = vals.reduce(function(a, b){ return a + (+b || 0); }, 0), c = 0, gap = 2.5;
    var s = '<circle cx="70" cy="70" r="' + R + '" fill="none" style="stroke:var(--track)" stroke-width="' + sw + '"/>';
    if (tot > 0) vals.forEach(function(v, i){
      v = +v || 0;
      var L = v / tot * C; if (L <= 0) return;
      s += '<circle class="sg" cx="70" cy="70" r="' + R + '" fill="none" stroke="' + cols[i] + '" stroke-width="' + sw + '" stroke-dasharray="' + Math.max(L - gap, .5).toFixed(2) + ' ' + C.toFixed(2) + '" stroke-dashoffset="-' + c.toFixed(2) + '" transform="rotate(-90 70 70)"/>';
      c += L;
    });
    return s;
  }

  function upgradeDonut(){
    var cv = document.getElementById('d-don');
    if (!cv || typeof charts === 'undefined' || !charts['d-don']) return;
    var ch = charts['d-don'];
    var box = cv.closest('.chartbox');
    var dc = document.getElementById('d-dc');
    if (!box) return;

    var vals = ch.data.datasets[0].data || [];
    var cols = ch.data.datasets[0].backgroundColor || [];
    var labs = (ch.data.labels || []).map(function(l){ return String(l).split('  ')[0]; });
    var tot = vals.reduce(function(a, b){ return a + (+b || 0); }, 0);
    var cNum = dc && dc.querySelector('b') ? dc.querySelector('b').textContent : fmtInt(tot);
    var cLbl = dc && dc.querySelector('span') ? dc.querySelector('span').textContent : 'unit';

    try { ch.destroy(); delete charts['d-don']; } catch(e){}

    var wrap = document.createElement('div');
    wrap.className = 'dn2';
    wrap.style.cursor = 'pointer';
    wrap.title = 'Klik untuk membuka halaman Program';
    wrap.innerHTML =
      '<div class="ring2">' +
        '<svg viewBox="0 0 140 140" role="img" aria-label="Komposisi semua program">' +
          dn2Ring(vals, cols, 52, 18) +
        '</svg>' +
        '<div class="ctr"><b>' + esc(cNum) + '</b><span>' + esc(cLbl) + '</span></div>' +
      '</div>' +
      '<ul>' +
        labs.map(function(n, i){
          var v = +vals[i] || 0;
          var pct = tot ? fmtP(v / tot * 100, 1) : '-';
          return '<li><i style="background:' + cols[i] + '"></i><span class="n">' + esc(n) + '</span><span class="p">' + pct + '</span><b>' + fmtInt(v) + ' unit</b></li>';
        }).join('') +
      '</ul>';

    wrap.addEventListener('click', function(){ if (typeof showTab === 'function') showTab('program'); });
    box.replaceWith(wrap);
  }

  var ring = document.getElementById('t-ringkasan');
  if (ring && window.MutationObserver) {
    new MutationObserver(function(){ setTimeout(upgradeDonut, 0); }).observe(ring, { childList: true });
  }
  setTimeout(upgradeDonut, 0);
})();
</script><!-- ===== PATCH TAMPILAN: sidebar scroll, transisi halaman, interaksi grafik, filter TW di header ===== -->
<style>
