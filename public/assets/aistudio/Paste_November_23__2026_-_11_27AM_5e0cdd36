  var setZ=function(z){ Z=Math.max(.55,Math.min(1.1,Math.round(z*100)/100)); document.documentElement.style.setProperty('--pz',Z); document.getElementById('pz').textContent=Math.round(Z*100)+'%'; rz(); };
  var visibleTabs=function(){
