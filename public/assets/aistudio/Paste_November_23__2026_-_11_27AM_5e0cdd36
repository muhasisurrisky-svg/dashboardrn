    var b=e.target.closest('button[data-a]'); if(!b) return; var a=b.getAttribute('data-a');
    if(a==='prev') go(-1); else if(a==='next') go(1); else if(a==='min') setZ(Z-.05); else if(a==='plus') setZ(Z+.05); else leave();
