.dn2 li:hover{background:var(--soft);border-radius:8px;transform:translateX(4px)}
.ring:hover .v{filter:brightness(1.15);opacity:.9}
canvas{transition:filter .2s ease}

/* 4. Angka & label kecil di grafik dibuat lebih besar */
.hb .lab{font-size:13.5px}
.hb .tr span{font-size:12.5px}
.ring i{font-size:14px}
.ci2 .cit{font-size:14px}
.bl2 .ax .sc{font-size:12.5px;height:15px}
