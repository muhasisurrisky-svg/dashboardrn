    }),F.vendor);

    tbl.setExt(function(x){
      return (F.tipe===null||tp(x)===F.tipe)&&(F.bulan===null||x[10]===F.bulan+1)&&(F.kat===null||x[9]===F.kat)&&(F.vendor===null||vd(x)===F.vendor);
    });

    var chips=[];
    if(F.tipe!==null)   chips.push(['tipe','Tipe: '+F.tipe]);
    if(F.bulan!==null)  chips.push(['bulan','Bulan: '+BLN_PENUH[F.bulan]]);
    if(F.kat!==null)    chips.push(['kat','Kategori: '+F.kat]);
    if(F.vendor!==null) chips.push(['vendor','Vendor: '+F.vendor]);
    $('#pb-filters').innerHTML=chips.length
