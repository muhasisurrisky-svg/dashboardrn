<script>
(function () {
  var aside = document.querySelector('aside'), sfoot = aside && aside.querySelector('.sfoot');
  if (!aside || !sfoot) return;

  /* a. kumpulkan tombol header (tema, fullscreen, presentation) ke sidebar */
  var tools = document.createElement('div'); tools.id = 'sbtools';
  var tg = document.createElement('button');
  tg.id = 'sbtoggle'; tg.type = 'button'; tg.className = 'fsbtn';
  tg.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg><span id="sbtlbl">Perkecil menu</span>';
  tools.appendChild(tg);
  ['themebtn', 'fsbtn', 'presbtn'].forEach(function (id) {
    var b = document.getElementById(id); if (b) tools.appendChild(b);   /* listener lama tetap jalan */
  });
  aside.insertBefore(tools, sfoot);

