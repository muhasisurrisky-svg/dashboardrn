    el.innerHTML = h;

    var cols = [
      { h: 'No. APAR' },
      { h: 'Titik Penempatan', fmt: function (v) { return v ? '<b>' + esc(v) + '</b>' : '<span class="badge" style="background:var(--red)">BELUM DIISI</span>'; } },
      { h: 'Jenis' }, { h: 'Kapasitas' }, { h: 'Kadaluarsa', fmt: dash },
      { h: 'Pengecekan Terakhir', fmt: function (v) { return v ? esc(v) : '<span style="color:var(--amber);font-weight:600">Belum ada data</span>'; } },
      { h: 'Kadaluarsa Berikutnya', fmt: dash },
      { h: 'Status', fmt: bdg },
      { h: 'Sisa Waktu', num: 1, fmt: function (v) { return v === '' ? '-' : (v < 0 ? 'terlambat ' + fmtInt(-v) + ' hari' : fmtInt(v) + ' hari'); } }
    ];
    tbl = mkTable(q('#tb-apar'), cols, ROWS, { pageSize: 30, filter: [{ idx: 7, label: 'Status' }, { idx: 2, label: 'Jenis' }, { idx: 3, label: 'Kapasitas' }] });

    /* ---- tabel titik penempatan ---- */
    function arrow(key) { return LS.k === key ? '<span class="ar">' + (LS.asc ? '▲' : '▼') + '</span>' : ''; }
    function lokTable() {
      var m = {};
      ROWS.filter(stOk).forEach(function (r) {
        var n = lokNama(r);
        if (!m[n]) m[n] = { k: n, total: 0, aman: 0, segera: 0, lewat: 0, nodata: 0 };
        var g = m[n]; g.total++;
        if (r[7] === 'Aman') g.aman++;
        else if (r[7] === 'Segera kadaluarsa') g.segera++;
        else if (r[7] === 'Kadaluarsa') g.lewat++;
        else g.nodata++;
      });
      var list = Object.keys(m).map(function (n) { return m[n]; });
      var qs = LS.q.toLowerCase();
      if (qs) list = list.filter(function (g) { return g.k.toLowerCase().indexOf(qs) > -1; });
      list.sort(function (a, b) {
        var d = LS.k === 'nama' ? a.k.localeCompare(b.k, 'id') : (a[LS.k] - b[LS.k]);
        d = LS.asc ? d : -d;
        return d || a.k.localeCompare(b.k, 'id');
      });
      q('#ap-lsum').textContent = fmtInt(list.length) + ' titik penempatan · klik baris untuk memfilter tabel daftar APAR';
      q('#tb-aplok').innerHTML =
        '<thead><tr>' +
        '<th data-s="nama" title="Klik untuk mengurutkan" style="cursor:pointer">Titik Penempatan' + arrow('nama') + '</th>' +
        '<th class="n" data-s="total" title="Klik untuk mengurutkan" style="cursor:pointer">APAR' + arrow('total') + '</th>' +
        '<th class="n">Aman</th>' +
        '<th class="n" data-s="segera" title="Klik untuk mengurutkan" style="cursor:pointer">Segera' + arrow('segera') + '</th>' +
        '<th class="n" data-s="lewat" title="Klik untuk mengurutkan" style="cursor:pointer">Kadaluarsa' + arrow('lewat') + '</th>' +
        '</tr></thead><tbody>' +
        (list.map(function (g) {
          return '<tr data-k="' + esc(g.k) + '" class="' + (F.lok === g.k ? 'sel' : '') + '"><td>' + esc(g.k) + '</td>' +
            '<td class="n">' + fmtInt(g.total) + '</td>' +
            '<td class="n">' + fmtInt(g.aman) + '</td>' +
            '<td class="n" style="' + (g.segera ? 'color:var(--amber);font-weight:700' : '') + '">' + fmtInt(g.segera) + '</td>' +
            '<td class="n" style="' + (g.lewat ? 'color:var(--red);font-weight:700' : '') + '">' + fmtInt(g.lewat) + '</td></tr>';
        }).join('') || '<tr><td colspan="5" class="empty">Tidak ada data.</td></tr>') +
        '</tbody>';
    }

    /* ---- donut status (mengikuti filter titik penempatan) ---- */
    var base = { responsive: true, maintainAspectRatio: false };
    function cntStatus() {
      var c = {}; ST.forEach(function (n) { c[n] = 0; });
      ROWS.filter(lokOk).forEach(function (r) { c[r[7]] = (c[r[7]] || 0) + 1; });
      return c;
    }
    var c0 = cntStatus();
    if (A.total > 0) mkChart('a-don', {
      type: 'doughnut',
      data: {
        labels: ST.map(function (n) { return n + ' (' + fmtInt(c0[n]) + ')'; }),
        datasets: [{
          data: ST.map(function (n) { return c0[n]; }),
          backgroundColor: function (ctx) { var c = SHEX[ctx.dataIndex]; return (F.st === null || F.st === ST[ctx.dataIndex]) ? c : hexA(c, .25); },
          borderColor: '#FFFFFF', borderWidth: 3
        }]
      },
      options: Object.assign({}, base, {
        cutout: '55%',
        plugins: { legend: { position: 'right', labels: { boxWidth: 14, boxHeight: 14, padding: 16, font:{size:14} } }, pctLabels: { mode: 'doughnut' } },
        onHover: function (e, els) { e.native.target.style.cursor = els.length ? 'pointer' : 'default'; },
        onClick: function (e, els) { if (!els.length) return; var s = ST[els[0].index]; F.st = (F.st === s) ? null : s; update(); }
      })
    });

    function update() {
      document.querySelectorAll('#ap-kpi [data-st]').forEach(function (c) { c.classList.toggle('act', F.st === c.getAttribute('data-st')); });
      lokTable();
      tbl.setExt(function (r) { return stOk(r) && lokOk(r); });

      var d = charts['a-don'];
      if (d) {
        var c = cntStatus();
        d.data.datasets[0].data = ST.map(function (n) { return c[n]; });
        d.data.labels = ST.map(function (n) { return n + ' (' + fmtInt(c[n]) + ')'; });
        d.update('none');
      }

      var chips = [];
      if (F.st !== null) chips.push(['st', F.st === '__noloc' ? 'Tanpa titik penempatan' : 'Status: ' + F.st]);
      if (F.lok !== null) chips.push(['lok', 'Titik penempatan: ' + F.lok]);
      q('#ap-filters').innerHTML = chips.length
        ? 'Filter aktif:' + chips.map(function (x) { return '<span class="chip">' + esc(x[1]) + ' <button data-x="' + x[0] + '" title="Hapus filter">✕</button></span>'; }).join('') + '<button class="rst" data-x="all">Reset semua</button>'
        : '';
    }

    q('#ap-kpi').addEventListener('click', function (e) {
      var c = e.target.closest('[data-st]'); if (!c) return;
      var s = c.getAttribute('data-st'); F.st = (F.st === s) ? null : s; update();
    });
    q('#ap-filters').addEventListener('click', function (e) {
      var x = e.target.getAttribute('data-x'); if (!x) return;
      if (x === 'all') { F.st = null; F.lok = null; } else { F[x] = null; }
      update();
    });
    q('#tb-aplok').addEventListener('click', function (e) {
      var th = e.target.closest('th[data-s]');
      if (th) {
        var s = th.getAttribute('data-s');
        if (LS.k === s) LS.asc = !LS.asc; else { LS.k = s; LS.asc = (s === 'nama'); }
        lokTable(); return;
      }
      var tr = e.target.closest('tr[data-k]'); if (!tr) return;
      var n = tr.getAttribute('data-k'); F.lok = (F.lok === n) ? null : n; update();
    });
    q('#ap-lq').addEventListener('input', function (e) { LS.q = e.target.value; lokTable(); });

    update();
  }
})();
</script>
