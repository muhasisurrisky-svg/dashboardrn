/* ---------- SUKU CADANG (Jumlah Harga = Qty x Harga Satuan) ---------- */
function renderSuku(){
  var el=$('#t-suku'), S=D.sukuCadang;
  if(!S){ el.innerHTML=nodata('suku cadang'); return; }
  function fq(v){ return (+v||0).toLocaleString('id-ID',{maximumFractionDigits:2}); }
  var rows=S.rows.map(function(r){ return r.slice(0,7).concat([(+r[5]||0)*(+r[6]||0)]); });
  var total=rows.reduce(function(s,r){return s+r[7];},0);

  var F={vendor:null,mat:null}, VS={k:'nilai',asc:false}, tbl=null, topMat=[];
  function vd(r){ return String(r[2]||'').trim()||'(belum ada vendor)'; }
  function mt(r){ return String(r[3]||'').trim()||'(tanpa deskripsi)'; }
  function pick(skip){
    return rows.filter(function(r){
      return (skip==='vendor'||F.vendor===null||vd(r)===F.vendor) &&
             (skip==='mat'||F.mat===null||mt(r)===F.mat);
    });
  }
  function group(rs,keyFn){
    var m={};
    rs.forEach(function(r){
      var k=keyFn(r); if(!m[k]) m[k]={k:k,baris:0,nilai:0,qty:0,mats:{}};
      var g=m[k]; g.baris++; g.nilai+=r[7]; g.qty+=(+r[5]||0); g.mats[mt(r)]=1;
    });
    return Object.keys(m).map(function(k){ var g=m[k]; g.jenis=Object.keys(g.mats).length; return g; });
  }
  function short(s,n){ s=String(s); return s.length>n?s.slice(0,n-1)+'…':s; }

  var h='<div class="fbar" id="sc-filters" style="margin-top:0"></div>';
  h+='<div class="grid cols2" style="margin-top:0">'+
     '<div class="card"><h3>10 material dengan nilai terbesar</h3><div class="hint" id="sc-sum"></div><div class="chartbox" style="height:360px"><canvas id="s-mat"></canvas></div></div>'+
     '<div class="card"><h3>Vendor suku cadang</h3><div class="hint">Klik baris vendor untuk memfilter chart dan tabel detail. Klik judul kolom untuk mengurutkan.</div><div class="tw mini" style="max-height:360px"><table class="clk" id="tb-scv"></table></div></div></div>';
  h+='<div class="card" style="margin-top:18px"><h3>Rekap Pengadaan Suku Cadang</h3><div class="hint">Cari lewat kotak pencarian, atau pilih filter vendor, judul pengadaan, dan deskripsi material. Tabel ini juga mengikuti filter chart dan vendor di atas.</div><div id="tb-sc"></div></div>';
  el.innerHTML=h;

  var cols=[{h:'Matnum'},{h:'Judul Pengadaan'},{h:'Vendor'},{h:'Deskripsi Material'},{h:'Satuan'},
    {h:'Qty',num:1,fmt:fq},{h:'Harga Satuan RAB',num:1,fmt:fmtRp},{h:'Jumlah Harga',num:1,fmt:fmtRp}];
  tbl=mkTable($('#tb-sc'),cols,rows,{pageSize:25,
    filter:[{idx:2,label:'Vendor'},{idx:1,label:'Judul Pengadaan'},{idx:3,label:'Deskripsi Material'}],
    foot:['','','','','','','TOTAL SEMUA',fmtRp(total)]});

  function barColor(ctx){
    var k=topMat[ctx.dataIndex];
    return (F.mat===null||k===F.mat)?C_BLUE:C_BLUE_DIM;
  }
  mkChart('s-mat',{type:'bar',
    data:{labels:[],datasets:[{label:'Nilai',data:[],backgroundColor:barColor,borderRadius:4}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{
        title:function(items){ return topMat[items[0].dataIndex]||''; },
        label:function(c){
          var g=c.chart.$grp&&c.chart.$grp[c.dataIndex];
          return [' Nilai: '+fmtRp(c.parsed.x), g?' Qty: '+fq(g.qty)+' · '+fmtInt(g.baris)+' baris':''];
        }}}},
      scales:{x:{beginAtZero:true,ticks:{callback:function(v){ return v>=1e9?(v/1e9).toLocaleString('id-ID')+' M':(v/1e6).toLocaleString('id-ID')+' jt'; }}},
              y:{grid:{display:false},ticks:{callback:function(v){ return short(this.getLabelForValue(v),30); }}}},
      onHover:function(e,els){ e.native.target.style.cursor=els.length?'pointer':'default'; },
      onClick:function(e,els){
        if(!els.length) return;
        var k=topMat[els[0].index]; F.mat=(F.mat===k)?null:k; update();
      }}});

  function arrow(k){ return VS.k===k?'<span class="ar">'+(VS.asc?'▲':'▼')+'</span>':''; }
  function vendorTable(list){
    var head='<thead><tr><th>Vendor</th>'+
      '<th class="n srt" data-s="jenis" title="Klik untuk mengurutkan">Jenis material'+arrow('jenis')+'</th>'+
      '<th class="n">Baris</th>'+
      '<th class="n srt" data-s="nilai" title="Klik untuk mengurutkan">Nilai'+arrow('nilai')+'</th></tr></thead>';
    var body=list.map(function(g){
      return '<tr data-k="'+esc(g.k)+'" class="'+(F.vendor===g.k?'sel':'')+'"><td>'+esc(g.k)+'</td><td class="n">'+fmtInt(g.jenis)+'</td><td class="n">'+fmtInt(g.baris)+'</td><td class="n">'+(g.nilai?fmtRp(g.nilai):'-')+'</td></tr>';
    }).join('')||'<tr><td colspan="4" class="empty">Tidak ada data.</td></tr>';
    $('#tb-scv').innerHTML=head+'<tbody>'+body+'</tbody>';
  }

  function update(){
    var all=pick(), vset={}, mset={}, nilai=0;
    all.forEach(function(r){ vset[vd(r)]=1; mset[mt(r)]=1; nilai+=r[7]; });
    $('#sc-sum').textContent=fmtInt(Object.keys(mset).length)+' jenis material · '+fmtInt(Object.keys(vset).length)+' vendor · '+fmtInt(all.length)+' baris · '+fmtRp(nilai);

    var g=group(pick('mat'),mt).sort(function(a,b){ return b.nilai-a.nilai; });
    var top=g.slice(0,10);
    if(F.mat!==null && !top.some(function(x){return x.k===F.mat;})){
      var s=g.filter(function(x){return x.k===F.mat;})[0];
      if(s) top[top.length-1]=s;
    }
    topMat=top.map(function(x){ return x.k; });
    var c=charts['s-mat'];
    c.$grp=top;
    c.data.labels=topMat;
    c.data.datasets[0].data=top.map(function(x){ return x.nilai; });
    c.update();

